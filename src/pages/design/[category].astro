---
/**
 * The three design category pages, from one template.
 *
 * Assets come straight from src/assets/design/<category>, so adding work is a
 * matter of dropping exports in the folder. Nothing here reads the work
 * collection: these are finished pieces to look at, not case studies with a
 * statement and an outcome.
 *
 * Every category uses the shoot page's browsing pattern: a packed masonry of
 * whole assets, click to open, arrows or swipe to move, escape out.
 *
 * Emails are shown at full length rather than cropped to a tile. They are 1080
 * by 5000-odd pixels, so the column is long, but that is the point: the work is
 * the whole email, and scrolling one is how you read it. Two columns hold even
 * on a phone, because a half-width email is still legible where a half-width
 * photograph would not be.
 */

import { Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../../layouts/Base.astro';
import Masonry from '../../components/Masonry.astro';
import Lightbox from '../../components/Lightbox.astro';
import ContactFooter from '../../components/ContactFooter.astro';
import {
  SUBSECTIONS,
  SUBSECTION_TITLE,
  type SubsectionKey,
} from '../../content.config';

const INTRO: Record<SubsectionKey, string> = {
  'paid-social':
    'Scroll-stopping creative for Meta and TikTok, built to be tested rather than admired.',
  email:
    'Campaign and lifecycle email design, from one-off sends to flows that keep running.',
  print: 'Stand graphics, printed collateral and the physical side of a launch.',
};

/** Which presentation each category uses. See the note at the top. */
const MODE: Record<SubsectionKey, 'wall'> = {
  'paid-social': 'wall',
  email: 'wall',
  print: 'wall',
};

const EMPTY: Record<SubsectionKey, string> = {
  'paid-social': 'Nothing here yet. This is where the paid social work will live.',
  email: 'Nothing here yet. This is where the email campaign work will live.',
  print: 'Nothing here yet. This is where the printed and event work will live.',
};

export function getStaticPaths() {
  return SUBSECTIONS.map((category) => ({ params: { category } }));
}

const { category } = Astro.params as { category: SubsectionKey };

/* Globs must be static, so all three are collected and the right one picked
   rather than interpolating the category into the pattern. */
const ALL = {
  'paid-social': import.meta.glob<{ default: ImageMetadata }>(
    '../../assets/design/paid-social/*.{jpg,jpeg,png}',
    { eager: true },
  ),
  email: import.meta.glob<{ default: ImageMetadata }>(
    '../../assets/design/email/*.{jpg,jpeg,png}',
    { eager: true },
  ),
  print: import.meta.glob<{ default: ImageMetadata }>(
    '../../assets/design/print/*.{jpg,jpeg,png}',
    { eager: true },
  ),
};

/* Filenames carry the campaign. Turning that into a label gives every asset
   usable alt text and a lightbox caption without per-file frontmatter. */
function labelFor(path: string): string {
  return path
    .split('/')
    .pop()!
    .replace(/\.[^.]+$/, '')
    .split('-')
    .filter(Boolean)
    .map((w) => (/^\d/.test(w) ? w : w.charAt(0).toUpperCase() + w.slice(1)))
    .join(' ');
}

const mode = MODE[category];

const assets = Object.entries(ALL[category])
  .sort(([a], [b]) => a.localeCompare(b, 'en', { numeric: true }))
  .map(([path, mod]) => ({
    src: mod.default,
    label: labelFor(path),
  }));

/* One larger variant per asset for the viewer, so the grid never has to load a
   full-size file and the lightbox costs a single request. */
const fulls = await Promise.all(
  assets.map((a) =>
    getImage({ src: a.src, format: 'webp', width: 1400, quality: 82 }),
  ),
);

const items = assets.map((a, i) => ({ ...a, full: fulls[i] }));
const title = SUBSECTION_TITLE[category];
---

<Base
  title={`${title} / Cole SJ`}
  description={INTRO[category]}
  ground="corner"
>
  <section class="dg">
    <header class="dg__head">
      <a href="/design" class="pill">Design</a>
      <h1 class="dg__title bloom warp-sm">{title}</h1>
      <p class="dg__count label">
        {items.length}
        {items.length === 1 ? 'piece' : 'pieces'}
      </p>
    </header>

    <p class="dg__intro text-pretty">{INTRO[category]}</p>

    {items.length === 0 && <p class="dg__empty text-pretty">{EMPTY[category]}</p>}

    {
      mode === 'wall' && items.length > 0 && (
        <div
          class="dg__wall"
          data-masonry
          data-cols={category === 'email' ? 2 : 3}
          data-cols-min="2"
        >
          {items.map((item, i) => (
            <div
              class="dg__cell"
              data-mas-item
              data-ar={item.src.height / item.src.width}
            >
              <button
                type="button"
                class="dg__shot"
                data-shot
                data-full={item.full.src}
                data-alt={item.label}
                data-caption={item.label}
                aria-label={`Open full size: ${item.label}`}
              >
                <Picture
                  src={item.src}
                  alt={item.label}
                  formats={['avif', 'webp']}
                  fallbackFormat="jpg"
                  widths={[320, 500, 760, 1100]}
                  sizes="(min-width: 1100px) 30vw, (min-width: 700px) 45vw, 92vw"
                  loading={i < 3 ? 'eager' : 'lazy'}
                  decoding="async"
                  class="dg__img"
                />
              </button>
            </div>
          ))}
        </div>
      )
    }

  </section>

  <Masonry />
  <Lightbox />
  <ContactFooter />
</Base>

<style>
  .dg {
    --dg-gap: clamp(0.35rem, 0.8vw, 0.7rem);
    padding: var(--spacing-gutter);
    padding-block-end: var(--spacing-room);
  }

  .dg__head {
    margin-bottom: clamp(1.5rem, 4vh, 2.5rem);
  }

  .dg__head a {
    color: var(--color-bone);
    text-decoration: none;
    transition:
      background-color 180ms var(--ease-settle),
      color 180ms var(--ease-settle);
  }

  .dg__head a:hover {
    background-color: var(--color-flare);
    color: var(--color-bone);
  }

  .dg__title {
    font-family: var(--font-display);
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    color: var(--color-flare);
    margin: 0;
  }

  .dg__count {
    opacity: 0.55;
    margin: 0;
  }

  .dg__intro {
    max-width: 52ch;
    margin: 0 0 clamp(2rem, 6vh, 3.5rem);
    font-size: var(--text-step-1);
    opacity: 0.8;
  }

  .dg__empty {
    max-width: 48ch;
    margin: 0;
    font-size: var(--text-step-1);
    opacity: 0.6;
  }

  /* -- Wall: paid social ------------------------------------------------- */

  .dg__wall {
    --mas-gap: var(--dg-gap);
  }

  .dg__shot {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    line-height: 0;
  }

  .dg__img {
    width: 100%;
    height: auto;
    transition: opacity 240ms var(--ease-settle);
  }

  .dg__shot:hover .dg__img,
  .dg__shot:focus-visible .dg__img {
    opacity: 0.78;
  }

</style>

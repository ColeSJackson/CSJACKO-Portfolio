---
/**
 * Case study detail. Karina structure: title, one paragraph of context, then
 * repeating blocks of bold statement plus media. Almost no body copy, the
 * statements carry the narrative. Minimal chrome, just a way back.
 */

import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../../layouts/Base.astro';
import Figure from '../../components/Figure.astro';
import StatStrip from '../../components/StatStrip.astro';
import ContactFooter from '../../components/ContactFooter.astro';
import { DISCIPLINE_LABEL, CONTEXT_LABEL } from '../../content.config';

export const getStaticPaths = (async () => {
  const entries = await getCollection('work', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);

/* Same source as the Proudest card, so a withheld piece is flagged identically
   in both places rather than the two drifting apart. */
const withheld = d.confidential;

/* An optional screenshot of the work in the wild, keyed by slug: drop
   src/assets/work/<slug>-site.<ext> and it appears beside the header copy.
   Globbed rather than declared in frontmatter so a missing file is simply an
   absent panel, not a build error. */
const siteShots = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/work/*-site.{jpg,jpeg,png,webp}',
  { eager: true },
);
const shotEntry = Object.entries(siteShots).find(([path]) =>
  path.split('/').pop()!.startsWith(`${entry.id}-site.`),
);
const siteShot = shotEntry?.[1].default;
---

<Base title={`${d.title} / ${d.client} / Cole SJ`} description={d.summary} ground="bone">
  <article class="cs">
    <nav class="cs__back">
      <a href="/" class="pill">Back</a>
      {d.placeholder && <span class="pill cs__flag">Placeholder entry</span>}
    </nav>

    <header class:list={['cs__head', 'cs__head--split']}>
      <div class="cs__intro">
        <p class="cs__meta label">
        <span>{DISCIPLINE_LABEL[d.discipline]}</span>
        <span>{d.client}</span>
        <span>{CONTEXT_LABEL[d.context]}</span>
        <span>{d.year}</span>
      </p>

      <h1 class="cs__title warp-sm">{d.title}</h1>

      {withheld && <p class="cs__confidential">CONFIDENTIAL</p>}

      <p class="cs__statement text-balance">{d.summary}</p>
      {d.statement && <p class="cs__outcome text-pretty">{d.statement}</p>}
      {d.outcome && <p class="cs__outcome text-pretty">{d.outcome}</p>}

      {d.externalUrl && (
        <p class="cs__credit">
          <a
            class="cs__link"
            href={d.externalUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            {d.credit ?? d.externalUrl}
            <svg class="cs__arrow" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true">
              <path
                d="M3 9L9 3M9 3H4.5M9 3v4.5"
                fill="none"
                stroke="currentColor"
                stroke-width="1.4"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
            <span class="sr-only">(opens in a new tab)</span>
          </a>
        </p>
      )}
      </div>

      {!siteShot && (
        <div class="cs__site cs__site--empty" aria-hidden="true">
          <span class="label">Image coming</span>
        </div>
      )}

      {siteShot && (
        <figure class="cs__site">
          <Picture
            src={siteShot}
            alt={`The ${d.client} site showing the work live.`}
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            widths={[600, 900, 1400]}
            sizes="(min-width: 900px) 46vw, 92vw"
            loading="eager"
            decoding="async"
            class="cs__site-img"
          />
        </figure>
      )}

    </header>

    <StatStrip stats={d.stats} publicResults={d.publicResults} />

    <div class="cs__cover">
      <Picture
        src={d.cover}
        alt={d.coverAlt}
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        widths={[600, 1000, 1600, 2000]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        class="cs__cover-img"
      />
    </div>

    <div class="cs__blocks">
      {
        d.media.map((block) => (
          <section class="block">
            <div class="block__copy">
              {block.label && <p class="block__label">{block.label}</p>}
              {block.statement && (
                <h2 class="block__statement text-balance">{block.statement}</h2>
              )}
              {block.outcome && (
                <p class="block__outcome text-pretty">{block.outcome}</p>
              )}
            </div>

            {block.assets.length > 0 && (
              <div
                class="block__assets"
                data-count={Math.min(block.assets.length, 3)}
              >
                {block.assets.map((asset) => (
                  <Figure
                    asset={asset}
                    placeholder={d.placeholder}
                    sizes={
                      block.assets.length > 1
                        ? '(min-width: 900px) 45vw, 92vw'
                        : '(min-width: 900px) 80vw, 92vw'
                    }
                  />
                ))}
              </div>
            )}
          </section>
        ))
      }
    </div>

    <div class="cs__prose">
      <Content />
    </div>
  </article>

  <ContactFooter />
</Base>

<style>
  .cs {
    background-color: var(--color-bone);
    color: var(--color-ink);
    padding-inline: var(--spacing-gutter);
    padding-block: clamp(1.25rem, 3vh, 2rem) var(--spacing-room);
  }

  .cs__back {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: clamp(2rem, 8vh, 5rem);
  }

  .cs__back a {
    color: inherit;
    text-decoration: none;
    transition:
      background-color 180ms var(--ease-settle),
      color 180ms var(--ease-settle);
  }

  .cs__back a:hover {
    background-color: var(--color-ink);
    color: var(--color-bone);
  }

  .cs__flag {
    color: var(--color-flare);
  }

  .cs__head {
    max-width: 62rem;
    margin-bottom: clamp(2rem, 5vh, 3rem);
  }

  .cs__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    opacity: 0.6;
    margin: 0 0 1.5rem;
  }

  /* Already caps in the markup; uppercase here guarantees nothing inherited
     can downcase it. */
  /* Two columns once there is a screenshot to show: copy left, the work in the
     wild right. Without one the header is a single column exactly as before,
     so a piece with no screenshot loses nothing. */
  .cs__head--split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3.5rem);
  }

  .cs__site {
    margin: 0;
    border-radius: clamp(0.75rem, 1.6vw, 1.25rem);
    overflow: hidden;
    background-color: var(--color-corner-lift);
    /* The screenshot is of a light site sitting in a dark room, so it needs an
       edge or it floats. */
    border: 1px solid color-mix(in srgb, var(--color-ink) 18%, transparent);
  }

  /* Holds the slot's space before the screenshot exists, so the layout is
     final now rather than shifting when one is dropped in. */
  .cs__site--empty {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    border-style: dashed;
    border-color: color-mix(in srgb, var(--color-ink) 28%, transparent);
    opacity: 0.5;
  }

  .cs__site-img {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (max-width: 900px) {
    .cs__head--split {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .cs__confidential {
    margin: 0 0 1.1rem;
    font-family: var(--font-display);
    font-size: var(--text-step-3);
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-flare);
  }

  .cs__credit {
    margin: 1.5rem 0 0;
  }

  .cs__link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: var(--text-step-0);
    line-height: 1.45;
    color: var(--color-flare);
    text-decoration: none;
    border-block-end: 1px solid
      color-mix(in srgb, var(--color-flare) 45%, transparent);
    padding-block-end: 0.15rem;
    transition: border-color 200ms var(--ease-settle);
  }

  .cs__link:hover,
  .cs__link:focus-visible {
    border-block-end-color: var(--color-flare);
  }

  .cs__arrow {
    flex: none;
  }

  /* Names the group: Product, Lifestyle. Small caps so it reads as a divider
     rather than competing with the block's own statement. */
  .block__label {
    margin: 0 0 0.5rem;
    font-family: var(--font-utility);
    font-size: var(--text-step--1);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    opacity: 0.55;
  }

  .cs__title {
    font-family: var(--font-display);
    font-size: var(--text-step-4);
    line-height: 0.9;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    margin: 0 0 1.5rem;
  }

  .cs__statement {
    font-family: var(--font-display);
    font-size: var(--text-step-2);
    line-height: 1.12;
    margin: 0 0 1rem;
    max-width: 24ch;
  }

  .cs__outcome {
    font-size: var(--text-step-1);
    line-height: 1.45;
    margin: 0;
    max-width: 52ch;
    opacity: 0.85;
  }

  .cs__cover {
    margin-block: clamp(2rem, 6vh, 4rem);
    /* Full bleed out of the page gutter. Images are uncompromised. */
    margin-inline: calc(var(--spacing-gutter) * -1);
  }

  .cs__cover-img {
    width: 100%;
    height: auto;
    max-height: 82svh;
    object-fit: cover;
  }

  .cs__blocks {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-room);
  }

  .block__copy {
    max-width: 34ch;
    margin-bottom: clamp(1.25rem, 3vh, 2rem);
  }

  .block__statement {
    font-family: var(--font-display);
    font-size: var(--text-step-2);
    line-height: 1.08;
    text-transform: none;
    letter-spacing: -0.015em;
    margin: 0 0 0.75rem;
  }

  .block__outcome {
    margin: 0;
    font-size: var(--text-step-0);
    opacity: 0.8;
  }

  .block__assets {
    display: grid;
    gap: clamp(0.75rem, 2vw, 1.5rem);
  }

  .block__assets[data-count='2'] {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .block__assets[data-count='3'] {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .cs__prose {
    max-width: 60ch;
    margin-top: var(--spacing-room);
    opacity: 0.7;
    font-size: var(--text-step--1);
  }

  @media (max-width: 760px) {
    .block__assets[data-count='2'],
    .block__assets[data-count='3'] {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

---
/**
 * Case study detail. Karina structure: title, one paragraph of context, then
 * repeating blocks of bold statement plus media. Almost no body copy, the
 * statements carry the narrative. Minimal chrome, just a way back.
 */

import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Figure from '../../components/Figure.astro';
import StatStrip from '../../components/StatStrip.astro';
import ContactFooter from '../../components/ContactFooter.astro';
import { DISCIPLINE_LABEL, CONTEXT_LABEL } from '../../content.config';

export const getStaticPaths = (async () => {
  const entries = await getCollection('work', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
---

<Base title={`${d.title} / ${d.client} / Cole SJ`} description={d.summary} ground="bone">
  <article class="cs">
    <nav class="cs__back">
      <a href="/" class="pill">Back</a>
      {d.placeholder && <span class="pill cs__flag">Placeholder entry</span>}
    </nav>

    <header class="cs__head">
      <p class="cs__meta label">
        <span>{DISCIPLINE_LABEL[d.discipline]}</span>
        <span>{d.client}</span>
        <span>{CONTEXT_LABEL[d.context]}</span>
        <span>{d.year}</span>
      </p>

      <h1 class="cs__title warp-sm">{d.title}</h1>

      <p class="cs__statement text-balance">{d.statement}</p>
      <p class="cs__outcome text-pretty">{d.outcome}</p>
    </header>

    <StatStrip stats={d.stats} publicResults={d.publicResults} />

    <div class="cs__cover">
      <Picture
        src={d.cover}
        alt={d.coverAlt}
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        widths={[600, 1000, 1600, 2000]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        class="cs__cover-img"
      />
    </div>

    <div class="cs__blocks">
      {
        d.media.map((block) => (
          <section class="block">
            <div class="block__copy">
              <h2 class="block__statement text-balance">{block.statement}</h2>
              {block.outcome && (
                <p class="block__outcome text-pretty">{block.outcome}</p>
              )}
            </div>

            {block.assets.length > 0 && (
              <div
                class="block__assets"
                data-count={Math.min(block.assets.length, 3)}
              >
                {block.assets.map((asset) => (
                  <Figure
                    asset={asset}
                    placeholder={d.placeholder}
                    sizes={
                      block.assets.length > 1
                        ? '(min-width: 900px) 45vw, 92vw'
                        : '(min-width: 900px) 80vw, 92vw'
                    }
                  />
                ))}
              </div>
            )}
          </section>
        ))
      }
    </div>

    <div class="cs__prose">
      <Content />
    </div>
  </article>

  <ContactFooter />
</Base>

<style>
  .cs {
    background-color: var(--color-bone);
    color: var(--color-ink);
    padding-inline: var(--spacing-gutter);
    padding-block: clamp(1.25rem, 3vh, 2rem) var(--spacing-room);
  }

  .cs__back {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: clamp(2rem, 8vh, 5rem);
  }

  .cs__back a {
    color: inherit;
    text-decoration: none;
    transition:
      background-color 180ms var(--ease-settle),
      color 180ms var(--ease-settle);
  }

  .cs__back a:hover {
    background-color: var(--color-ink);
    color: var(--color-bone);
  }

  .cs__flag {
    color: var(--color-flare);
  }

  .cs__head {
    max-width: 62rem;
    margin-bottom: clamp(2rem, 5vh, 3rem);
  }

  .cs__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    opacity: 0.6;
    margin: 0 0 1.5rem;
  }

  .cs__title {
    font-family: var(--font-display);
    font-size: var(--text-step-4);
    line-height: 0.9;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    margin: 0 0 1.5rem;
  }

  .cs__statement {
    font-family: var(--font-display);
    font-size: var(--text-step-2);
    line-height: 1.12;
    margin: 0 0 1rem;
    max-width: 24ch;
  }

  .cs__outcome {
    font-size: var(--text-step-1);
    line-height: 1.45;
    margin: 0;
    max-width: 52ch;
    opacity: 0.85;
  }

  .cs__cover {
    margin-block: clamp(2rem, 6vh, 4rem);
    /* Full bleed out of the page gutter. Images are uncompromised. */
    margin-inline: calc(var(--spacing-gutter) * -1);
  }

  .cs__cover-img {
    width: 100%;
    height: auto;
    max-height: 82svh;
    object-fit: cover;
  }

  .cs__blocks {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-room);
  }

  .block__copy {
    max-width: 34ch;
    margin-bottom: clamp(1.25rem, 3vh, 2rem);
  }

  .block__statement {
    font-family: var(--font-display);
    font-size: var(--text-step-2);
    line-height: 1.08;
    text-transform: none;
    letter-spacing: -0.015em;
    margin: 0 0 0.75rem;
  }

  .block__outcome {
    margin: 0;
    font-size: var(--text-step-0);
    opacity: 0.8;
  }

  .block__assets {
    display: grid;
    gap: clamp(0.75rem, 2vw, 1.5rem);
  }

  .block__assets[data-count='2'] {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .block__assets[data-count='3'] {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .cs__prose {
    max-width: 60ch;
    margin-top: var(--spacing-room);
    opacity: 0.7;
    font-size: var(--text-step--1);
  }

  @media (max-width: 760px) {
    .block__assets[data-count='2'],
    .block__assets[data-count='3'] {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

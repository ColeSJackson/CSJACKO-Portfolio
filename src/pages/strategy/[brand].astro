---
/**
 * A brand's planned programmes, from one template.
 *
 * /strategy/keis, /strategy/sw-motech and /strategy/nexx are the same page with
 * a different filter, generated from BRANDS. Each renders that brand's strands
 * in `order`, and each strand renders whichever of the two shapes it carries.
 *
 * `groups` becomes a dated table, because a named send on a named day is the
 * evidence. `cadence` becomes a row of facts, because a rhythm repeating sixty
 * times is not evidenced by printing it sixty times.
 */

import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ContactFooter from '../../components/ContactFooter.astro';
import {
  BRANDS,
  BRAND_LABEL,
  BRAND_PERIOD,
  STRAND_LABEL,
  type BrandKey,
} from '../../content.config';

export function getStaticPaths() {
  return BRANDS.map((brand) => ({ params: { brand } }));
}

const { brand } = Astro.params as { brand: BrandKey };

const plans = (
  await getCollection(
    'strategy',
    ({ data }) => !data.draft && data.brand === brand,
  )
).sort((a, b) => a.data.order - b.data.order);

const label = BRAND_LABEL[brand];
const dated = plans.reduce(
  (n, p) => n + p.data.groups.reduce((m, g) => m + g.items.length, 0),
  0,
);
---

<Base
  title={`${label} strategy / Cole SJ`}
  description={`Planned content programmes for ${label}: ${plans
    .map((p) => STRAND_LABEL[p.data.strand].toLowerCase())
    .join(', ')}.`}
  ground="corner"
>
  <section class="bp">
    <header class="bp__head">
      <a href="/strategy" class="pill">Strategy</a>
      <h1 class="bp__title bloom warp-sm">{label}</h1>
      <p class="bp__count label">
        {BRAND_PERIOD[brand]}{dated > 0 && ` / ${dated} planned dates`}
      </p>
    </header>

    {
      plans.map((plan) => {
        const d = plan.data;
        return (
          <article class="plan">
            <header class="plan__head">
              <p class="plan__strand label">{STRAND_LABEL[d.strand]}</p>
              <h2 class="plan__title">{d.title}</h2>
              <p class="plan__period label">{d.period}</p>
              <p class="plan__summary text-pretty">{d.summary}</p>
            </header>

            {d.cadence.length > 0 && (
              <dl class="cad">
                {d.cadence.map((c) => (
                  <div class="cad__item">
                    <dt class="label">{c.label}</dt>
                    <dd>{c.value}</dd>
                  </div>
                ))}
              </dl>
            )}

            {d.platforms.length > 0 && (
              <p class="plan__platforms label">{d.platforms.join(' / ')}</p>
            )}

            {d.groups.map((group) => (
              <section class="grp">
                <h3 class="grp__head label">
                  {group.label}
                  <span class="grp__count">{group.items.length}</span>
                </h3>

                {/* Email sends are cards; everything else stays a schedule.
                    A send has a subject and a preview line to show, which is
                    card-shaped content. A video shoot date is a date and a
                    title, and a card of that is a lot of box around very
                    little. */}
                {d.strand === 'email' ? (
                  <ul class="cards">
                    {group.items.map((item) => (
                      <li class="ec">
                        <p class="ec__title">{item.title}</p>
                        {item.date && <p class="ec__date">{item.date}</p>}
                        {item.subject && (
                          <p class="ec__subject text-pretty">{item.subject}</p>
                        )}
                        {(item.preview || item.note) && (
                          <p class="ec__preview text-pretty">
                            {item.preview ?? item.note}
                          </p>
                        )}
                      </li>
                    ))}
                  </ul>
                ) : (
                  <ol class="grp__list">
                    {group.items.map((item) => (
                      <li class="row">
                        <span class="row__date">{item.date}</span>
                        <span class="row__body">
                          <span class="row__title">{item.title}</span>
                          {item.note && (
                            <span class="row__note">{item.note}</span>
                          )}
                        </span>
                      </li>
                    ))}
                  </ol>
                )}
              </section>
            ))}
          </article>
        );
      })
    }
  </section>

  <ContactFooter />
</Base>

<style>
  .bp {
    background-color: var(--color-corner);
    padding: var(--spacing-gutter);
    padding-block-end: var(--spacing-room);
  }

  .bp__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 1rem 1.5rem;
    margin-bottom: clamp(2rem, 6vh, 4rem);
  }

  .bp__head a {
    color: var(--color-bone);
    text-decoration: none;
    transition:
      background-color 180ms var(--ease-settle),
      color 180ms var(--ease-settle);
  }

  .bp__head a:hover {
    background-color: var(--color-flare);
    color: var(--color-bone);
  }

  .bp__title {
    font-family: var(--font-display);
    font-size: var(--text-step-3);
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    color: var(--color-flare);
    margin: 0;
    margin-inline-end: auto;
  }

  .bp__count {
    opacity: 0.55;
    margin: 0;
  }

  .plan {
    margin-bottom: var(--spacing-room);
  }

  .plan__head {
    max-width: 62ch;
  }

  .plan__strand {
    color: var(--color-flare);
    margin: 0 0 0.5rem;
  }

  .plan__title {
    font-family: var(--font-display);
    font-size: var(--text-step-2);
    line-height: 1.05;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    margin: 0 0 0.4rem;
  }

  .plan__period {
    opacity: 0.55;
    margin: 0 0 1rem;
  }

  .plan__summary {
    margin: 0;
    /* Was step-0, the same size as a caption. This is the paragraph that
       explains the whole programme, so it reads at body-plus. */
    font-size: var(--text-step-1);
    line-height: 1.55;
    opacity: 0.85;
  }

  .plan__platforms {
    opacity: 0.55;
    margin: 1rem 0 0;
  }

  /* The rhythm, stated once. */
  .cad {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1.5rem, 4vw, 3rem);
    margin: 1.75rem 0 0;
    padding-block: 1.25rem;
    border-block: 1px solid
      color-mix(in srgb, var(--color-bone) 22%, transparent);
  }

  .cad__item dt {
    opacity: 0.6;
    margin-bottom: 0.4rem;
  }

  .cad__item dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-step-2);
    line-height: 1;
    color: var(--color-flare);
  }

  .grp {
    margin-top: clamp(1.75rem, 4vh, 2.5rem);
  }

  .grp__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    font-size: var(--text-step-0);
    margin: 0 0 1.15rem;
    padding-block-end: 0.7rem;
    border-block-end: 1px solid
      color-mix(in srgb, var(--color-bone) 28%, transparent);
  }

  .grp__count {
    opacity: 0.55;
  }

  .grp__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Date in its own column so the eye can run down the schedule without
     reading the titles, which is how anyone actually scans a calendar. */
  .row {
    display: grid;
    grid-template-columns: minmax(10rem, 13rem) minmax(0, 1fr);
    gap: 1.25rem;
    align-items: baseline;
    padding-block: 0.9rem;
    border-block-end: 1px solid
      color-mix(in srgb, var(--color-bone) 12%, transparent);
  }

  /* The dates carried the `label` class, which is small caps at step--2, and
     at that size a column of them read as grey noise rather than a schedule.
     They are the spine of this view: you scan the dates first and the titles
     second. So they take the display face, step-1, and the brand red, which
     also stops them competing with the titles on weight alone. */
  .row__date {
    font-family: var(--font-display);
    font-size: var(--text-step-1);
    line-height: 1.1;
    color: var(--color-flare);
    /* Lining figures of even width, so the column aligns down the page. */
    font-variant-numeric: tabular-nums;
  }

  .row__body {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .row__title {
    font-size: var(--text-step-1);
    line-height: 1.35;
  }

  .row__note {
    font-size: var(--text-step-0);
    opacity: 0.65;
    line-height: 1.45;
  }

  /* -- Email sends as cards ---------------------------------------------
     Square-ish tiles on an even grid, per the reference, rebuilt in the site's
     dark palette rather than its light one: a lifted ground one step off the
     page, a hairline border, and the same generous radius.

     Hierarchy runs top to bottom exactly as the header is ordered. Title
     carries the display face and the most weight; date is red and small caps
     so it reads as metadata rather than another line of copy; subject sits at
     body size; preview is the lightest thing on the card. */
  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(0.9rem, 1.8vw, 1.5rem);
  }

  .ec {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    /* Square is the target, but a card whose copy overruns should grow rather
       than clip, so the ratio is a floor via min-height. */
    min-height: 0;
    aspect-ratio: 1 / 1;
    padding: clamp(1rem, 1.8vw, 1.4rem);
    border-radius: clamp(0.75rem, 1.5vw, 1.1rem);
    background-color: var(--color-corner-lift);
    border: 1px solid color-mix(in srgb, var(--color-bone) 14%, transparent);
    transition:
      border-color 220ms var(--ease-settle),
      transform 320ms var(--ease-settle);
  }

  .ec:hover {
    border-color: var(--color-flare);
    transform: translateY(-2px);
  }

  .ec__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-step-1);
    line-height: 1.15;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }

  .ec__date {
    margin: 0;
    font-family: var(--font-utility);
    font-size: var(--text-step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-flare);
  }

  .ec__subject {
    margin: 0.15rem 0 0;
    font-size: var(--text-step-0);
    line-height: 1.4;
  }

  .ec__preview {
    margin: 0;
    font-size: var(--text-step-0);
    line-height: 1.45;
    opacity: 0.6;
  }

  @media (max-width: 1100px) {
    .cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 820px) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .row {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.15rem;
    }

    .ec {
      /* A square card at phone width is mostly empty space. Let the copy set
         the height instead. */
      aspect-ratio: auto;
    }
  }
</style>

---
/**
 * Edit. Reached from the word EDIT in the hero.
 *
 * Laid out like the shoot page: a wall of frames you scroll, tap to open, and
 * move through without going back. The difference is that every frame here is
 * a poster over a real file rather than a still.
 *
 * The cuts are served from this site rather than a video host: re-encoded for
 * web at 720 wide the whole library is about 230MB, which is cheap enough to
 * host directly, and it means a reel opens in place instead of handing the
 * viewer off to a third party mid-portfolio.
 *
 * The wall went from six clips to thirty-four across four brands, which is why
 * it now filters. Chips are driven by what is actually in the data, so one can
 * never advertise a brand with nothing behind it, and the count follows the
 * filter rather than stating a total the screen contradicts.
 *
 * The filter is also addressable: /edit?brand=splash opens pre-filtered, which
 * is what lets a case study link "See all Splash Comics videos" at a view
 * rather than at the top of the whole wall.
 *
 * Add a reel in src/data/reels.ts. See the note there.
 */

import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import ReelLightbox from '../components/ReelLightbox.astro';
import BrandFilter from '../components/BrandFilter.astro';
import ContactFooter from '../components/ContactFooter.astro';
import {
  REELS,
  REEL_BRAND_LABEL,
  brandsWithReels,
  reelSrc,
  sortReels,
} from '../data/reels';

/* Posters are globbed and matched by slug rather than imported per reel, so
   adding one is a file drop. The lookup throws on a miss, naming the slug:
   a reel with no poster is a mistake worth failing the build over, because the
   alternative is a tile that is silently a black rectangle. */
const posters = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/reels/*/*.jpg',
  { eager: true },
);

function posterFor(brand: string, slug: string): ImageMetadata {
  const hit = posters[`../assets/reels/${brand}/${slug}.jpg`];
  if (!hit) {
    throw new Error(
      `No poster for reel "${slug}". Expected src/assets/reels/${brand}/${slug}.jpg`,
    );
  }
  return hit.default;
}

const reels = sortReels(REELS).map((reel) => ({
  ...reel,
  poster: posterFor(reel.brand, reel.slug),
  src: reelSrc(reel),
  brandLabel: REEL_BRAND_LABEL[reel.brand],
}));

const filterBrands = brandsWithReels(REELS);
const counts = Object.fromEntries(
  filterBrands.map((b) => [b, reels.filter((r) => r.brand === b).length]),
);
---

<Base
  title="Edit / Cole SJ"
  description="Video work by Cole SJ. Campaign films, unboxings, social reels and short form, shot and cut end to end."
  ground="corner"
>
  <section class="rw">
    <header class="rw__head">
      <a href="/" class="pill">Back</a>
      <h1 class="rw__title bloom warp-sm">Edit</h1>
      {/* Live, and the filter rewrites it. Rendered with the full count so the
          figure is right before any script runs. */}
      <p class="rw__count label" data-filter-count>{reels.length} reels</p>
    </header>

    <BrandFilter
      brands={filterBrands}
      counts={counts}
      total={reels.length}
      noun="reel"
    />

    <ul class="rw__grid">
      {
        reels.map((reel, i) => (
          <li class="rw__cell" data-filter-item data-brand={reel.brand}>
            <button
              type="button"
              class="rw__shot"
              data-reel
              data-src={reel.src}
              data-title={reel.title}
              data-poster={reel.poster.src}
            >
              {/* A visually hidden word rather than an aria-label. An explicit
                  label REPLACES the accessible name, so it has to repeat every
                  visible string or it fails label-in-name; composing the name
                  from the content means it can never drift from what is on
                  screen. */}
              <span class="sr-only">Play: </span>
              {/* The tile is a 9:16 crop whatever the source shape, which is
                  the standard shorts-shelf treatment and keeps the wall even.
                  The one landscape film in the set is cropped here and played
                  at its true ratio in the viewer, which contains rather than
                  covers. The video is never cropped, only its thumbnail. */}
              <Picture
                src={reel.poster}
                alt={`Still from ${reel.title}`}
                formats={['avif', 'webp']}
                fallbackFormat="jpg"
                widths={[320, 500, 760]}
                sizes="(min-width: 1100px) 30vw, (min-width: 700px) 45vw, 92vw"
                loading={i < 3 ? 'eager' : 'lazy'}
                decoding="async"
                class="rw__img"
              />
              <span class="rw__play" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22">
                  <path d="M8 5v14l11-7z" fill="currentColor" />
                </svg>
              </span>
              <span class="rw__caption">
                <span class="rw__label">{reel.title}</span>
                <span class="rw__meta">
                  {reel.brandLabel}{reel.year ? ` / ${reel.year}` : ''}
                </span>
              </span>
            </button>
          </li>
        ))
      }
    </ul>

    <p class="rw__none label" data-filter-none hidden>
      Nothing under that filter yet.
    </p>
  </section>

  <ReelLightbox />
  <ContactFooter />
</Base>

<style>
  .rw {
    /* Matches the shoot wall, so the two sections read as one system. */
    --rw-gap: clamp(0.3rem, 0.7vw, 0.62rem);
    padding: var(--spacing-gutter);
    padding-block-end: var(--spacing-room);
  }

  .rw__head {
    margin-bottom: clamp(1.25rem, 3vh, 2rem);
  }

  .rw__head a {
    color: inherit;
    text-decoration: none;
    transition:
      background-color 180ms var(--ease-settle),
      color 180ms var(--ease-settle);
  }

  .rw__head a:hover {
    background-color: var(--color-bone);
    color: var(--color-ink);
  }

  .rw__title {
    font-family: var(--font-display);
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .rw__count {
    opacity: 0.6;
    margin: 0;
  }

  /* A plain grid, not the masonry the shoot page needs: every tile is a 9:16
     crop, so there are no varying heights to pack around. It also keeps
     filtering trivial, because hiding a cell cannot strand a gap. */
  .rw__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--rw-gap);
  }

  .rw__shot {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 9 / 16;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    line-height: 0;
    overflow: hidden;
  }

  .rw__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      opacity 240ms var(--ease-settle),
      transform 400ms var(--ease-settle);
  }

  .rw__shot:hover .rw__img,
  .rw__shot:focus-visible .rw__img {
    opacity: 0.72;
    transform: scale(1.02);
  }

  /* The affordance has to be permanent. A hover-only play badge is invisible on
     every touch device, which is where most of these will be watched. */
  .rw__play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--color-bone) 70%, transparent);
    background-color: color-mix(in srgb, var(--color-ink) 45%, transparent);
    color: var(--color-bone);
    backdrop-filter: blur(2px);
    padding-left: 0.15rem;
    transition:
      background-color 220ms var(--ease-settle),
      border-color 220ms var(--ease-settle);
  }

  .rw__shot:hover .rw__play,
  .rw__shot:focus-visible .rw__play {
    background-color: var(--color-flare);
    border-color: var(--color-flare);
  }

  .rw__caption {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 2.75rem 0.85rem 0.7rem;
    text-align: left;
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--color-ink) 82%, transparent),
      transparent
    );
  }

  /* Was the display face at step-1. Groovy Madness is a poster face with soft,
     irregular letterforms: at tile size over moving footage it read as an odd
     typeface rather than a title, which is exactly the complaint. The text
     face at step-0 is simply legible, which is all a caption has to be. */
  .rw__label {
    font-family: var(--font-utility);
    font-size: var(--text-step-0);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: 0.01em;
    color: var(--color-bone);
  }

  .rw__meta {
    font-family: var(--font-utility);
    font-size: var(--text-step--1);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1.2;
    color: var(--color-bone);
    opacity: 0.62;
  }

  .rw__none {
    margin: 2rem 0 0;
    opacity: 0.6;
  }

  @media (max-width: 1100px) {
    .rw__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .rw__grid {
      /* Two across on a phone rather than one. At thirty-four reels a single
         column is a very long scroll, and a 9:16 tile at half a phone's width
         is still a readable thumbnail. */
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .rw__caption {
      padding: 1.75rem 0.55rem 0.5rem;
    }

    .rw__label {
      font-size: var(--text-step--1);
    }

    .rw__meta {
      font-size: var(--text-step--2);
    }

    .rw__play {
      width: 2.5rem;
      height: 2.5rem;
    }
  }
</style>

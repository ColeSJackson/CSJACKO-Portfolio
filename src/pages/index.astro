---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Proudest from '../components/Proudest.astro';
import SplashBand from '../components/SplashBand.astro';
import ContactFooter from '../components/ContactFooter.astro';

/* The proudest three. The full index lives at /work: someone should get the
   range from this page in one screen, and the volume only if they go looking
   for it. */
const featured = (await getCollection('work', ({ data }) => !data.draft))
  .filter((entry) => entry.data.featured)
  .sort((a, b) => (a.data.round ?? 99) - (b.data.round ?? 99));
---

<Base
  title="Cole SJ / Content and Digital Marketing"
  description="Cole SJ, content creator and marketer. Photography, video, design and strategy for KEIS, O'Neills Sportswear and my own comic shop, Splash Comics."
  logo={false}
>
  <Hero />
  <Proudest entries={featured} />
  {/* Between the work and the contact block, deliberately: it is the last
      thing read before the email address. */}
  <SplashBand />
  <ContactFooter />
</Base>

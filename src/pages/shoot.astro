---
/**
 * The photography wall.
 *
 * Every frame in src/assets/shoot is pulled in automatically, so adding work is
 * a matter of dropping exports into the source folder and running `npm run
 * photos`. No frontmatter, no per-image markup.
 *
 * Two rules govern the look:
 *
 *   1. Nothing is cropped. Every frame keeps its native aspect ratio, so a tall
 *      portrait stays tall and a wide frame stays wide. The grid bends around
 *      the photographs rather than the photographs being cut to fit the grid.
 *
 *   2. Favourites lead, spread across every column. They render in their own
 *      CSS Grid (3 columns, row-flow) rather than the masonry below, because
 *      column-based masonry fills one column completely before starting the
 *      next: with the favourites first in source order that packed all of
 *      them into column one instead of spreading them. Grid fills row by
 *      row, so a 3-wide row means every third pick lands in the same column,
 *      which reads as spread rather than stacked.
 *
 *      Edit FAVOURITES to change the picks or their order.
 */

import { Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import Lightbox from '../components/Lightbox.astro';
import ContactFooter from '../components/ContactFooter.astro';

const modules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/shoot/*.{jpg,jpeg,png}',
  { eager: true },
);

/* Filenames carry the shoot they came from. Turning that into a readable label
   gives every frame a usable alt text and a lightbox caption without 71 lines
   of hand-written frontmatter. Frames whose names are only a camera counter
   fall back to a plain description. */
const CAMERA_NOISE = /^(dsc|img|image|untitled)[-_]?\d*$/i;

/* Cole's picks, in the order they should appear. Matched against the
   processed filename (no extension) in src/assets/shoot. */
const FAVOURITES = [
  '2025-london-090',
  '2025-london-237',
  'bjj-champs-2026-25',
  'devpare-17',
  'devpare-18',
  'devpare-38',
  'devpare-50',
  'devpare-56',
  'image-115',
  'image-120',
  'image-193',
  'keis-new-forest-038',
  'keis-new-forest-050',
  'keis-new-forest-055',
  'keis-new-forest-056',
  'photograph-048',
];

function basenameOf(path: string): string {
  return path.split('/').pop()!.replace(/\.[^.]+$/, '');
}

function labelFor(path: string): string {
  const stem = path.split('/').pop()!.replace(/\.[^.]+$/, '');
  const withoutIndex = stem.replace(/-\d+$/, '');

  if (!withoutIndex || CAMERA_NOISE.test(withoutIndex)) {
    return 'Combat sports photography by Cole SJ';
  }

  const words = withoutIndex
    .split('-')
    .filter(Boolean)
    .map((w) => (/^\d+$/.test(w) ? w : w.charAt(0).toUpperCase() + w.slice(1)))
    .join(' ');

  return words;
}

type Shot = {
  src: ImageMetadata;
  alt: string;
  caption: string;
  /* Wide frames earn more room; the rest vary on a fixed rhythm. */
  span: 1 | 2;
};

const shots: Shot[] = Object.entries(modules)
  .sort(([a], [b]) => {
    const ai = FAVOURITES.indexOf(basenameOf(a));
    const bi = FAVOURITES.indexOf(basenameOf(b));

    /* Both favourites: keep FAVOURITES' order. One favourite: it wins.
       Neither: fall back to the original alphabetical order. */
    if (ai !== -1 && bi !== -1) return ai - bi;
    if (ai !== -1) return -1;
    if (bi !== -1) return 1;
    return a.localeCompare(b, 'en', { numeric: true });
  })
  .map(([path, mod]) => {
    const src = mod.default;
    const label = labelFor(path);
    const landscape = src.width > src.height;

    return {
      src,
      alt: label,
      caption: label,
      /* Landscape frames read as squashed at a single column width, so they
         take two. Everything else stays one, which keeps the wall dense. */
      span: (landscape ? 2 : 1) as 1 | 2,
    };
  });

/* One larger variant per frame, generated at build time, so the lightbox costs
   a single request and the grid never has to load a full-size image. */
const fulls = await Promise.all(
  shots.map((shot) =>
    getImage({ src: shot.src, format: 'webp', width: 1800, quality: 82 }),
  ),
);

/* shots is already sorted favourites-first (see the comparator above), so a
   straight slice at FAVOURITES.length splits it into the two display groups
   without needing to re-match filenames. fulls stays index-aligned with shots
   throughout, which is why it is paired here rather than recomputed. */
const paired = shots.map((shot, i) => ({ shot, full: fulls[i] }));
const favourites = paired.slice(0, FAVOURITES.length);
const rest = paired.slice(FAVOURITES.length);
---

<Base
  title="Shoot / Cole SJ"
  description="Combat sports photography by Cole SJ. Boxing, Muay Thai and BJJ, ringside and in the gym."
  ground="corner"
>
  <section class="ph">
    <header class="ph__head">
      <a href="/" class="pill">Back</a>
      <h1 class="ph__title bloom warp-sm">Shoot</h1>
      <p class="ph__count label">{shots.length} frames</p>
    </header>

    <ul class="ph__top">
      {
        favourites.map(({ shot, full }, i) => (
          <li class="ph__top-cell">
            <button
              type="button"
              class="ph__shot"
              data-shot
              data-full={full.src}
              data-alt={shot.alt}
              data-caption={shot.caption}
              aria-label={`Open full size: ${shot.alt}`}
            >
              <Picture
                src={shot.src}
                alt={shot.alt}
                formats={['avif', 'webp']}
                fallbackFormat="jpg"
                widths={[320, 500, 760, 1100]}
                sizes="(min-width: 1100px) 30vw, (min-width: 700px) 45vw, 92vw"
                loading={i < 3 ? 'eager' : 'lazy'}
                decoding="async"
                fetchpriority={i < 3 ? 'high' : 'auto'}
                class="ph__img"
              />
            </button>
          </li>
        ))
      }
    </ul>

    <ul class="ph__grid">
      {
        rest.map(({ shot, full }) => (
          <li class="ph__cell" data-span={shot.span}>
            <button
              type="button"
              class="ph__shot"
              data-shot
              data-full={full.src}
              data-alt={shot.alt}
              data-caption={shot.caption}
              aria-label={`Open full size: ${shot.alt}`}
            >
              <Picture
                src={shot.src}
                alt={shot.alt}
                formats={['avif', 'webp']}
                fallbackFormat="jpg"
                widths={[320, 500, 760, 1100]}
                sizes="(min-width: 1100px) 30vw, (min-width: 700px) 45vw, 92vw"
                loading="lazy"
                decoding="async"
                class="ph__img"
              />
            </button>
          </li>
        ))
      }
    </ul>
  </section>

  <Lightbox />
  <ContactFooter />
</Base>

<style>
  .ph {
    background-color: var(--color-corner);
    padding: var(--spacing-gutter);
    padding-block-end: var(--spacing-room);
  }

  .ph__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 1rem 1.5rem;
    margin-bottom: clamp(2rem, 6vh, 4rem);
  }

  .ph__head a {
    color: inherit;
    text-decoration: none;
    transition:
      background-color 180ms var(--ease-settle),
      color 180ms var(--ease-settle);
  }

  .ph__head a:hover {
    background-color: var(--color-bone);
    color: var(--color-ink);
  }

  .ph__title {
    font-family: var(--font-display);
    font-size: var(--text-step-3);
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    margin: 0;
    margin-inline-end: auto;
  }

  .ph__count {
    opacity: 0.6;
    margin: 0;
  }

  /* Favourites: a real 3-column grid, row-flow, so picks land one-per-column
     in reading order (1st in col 1, 2nd in col 2, 3rd in col 3, 4th back in
     col 1, and so on) rather than stacking down column one the way the
     masonry below would.

     align-items: start is what keeps this from becoming the row grid the
     masonry comment below warns against: a shorter neighbour in the same row
     just leaves gap beneath it instead of being stretched or cropped to match
     the row's tallest cell. */
  .ph__top {
    list-style: none;
    margin: 0 0 clamp(1.5rem, 4vw, 3rem);
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: start;
    gap: clamp(0.4rem, 1.2vw, 0.9rem);
  }

  /* Column masonry rather than a row grid, because columns let every frame keep
     its own height. A row grid would force a shared row height and start
     cropping, which is the one thing this page must not do. */
  .ph__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 3;
    column-gap: clamp(0.4rem, 1.2vw, 0.9rem);
  }

  .ph__cell {
    break-inside: avoid;
    margin-bottom: clamp(0.4rem, 1.2vw, 0.9rem);
  }

  /* Landscape frames break the column rhythm on purpose. In a wall of mostly
     portrait work they are the thing that stops it reading as a tidy grid. */
  .ph__cell[data-span='2'] {
    column-span: none;
  }

  .ph__shot {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    line-height: 0;
  }

  .ph__img {
    width: 100%;
    height: auto;
    transition:
      opacity 240ms var(--ease-settle),
      filter 240ms var(--ease-settle);
  }

  .ph__shot:hover .ph__img,
  .ph__shot:focus-visible .ph__img {
    opacity: 0.78;
  }

  @media (max-width: 1100px) {
    .ph__top {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .ph__grid {
      columns: 2;
    }
  }

  @media (max-width: 620px) {
    .ph__top {
      grid-template-columns: minmax(0, 1fr);
    }

    .ph__grid {
      columns: 1;
    }
  }
</style>

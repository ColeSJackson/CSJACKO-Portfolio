---
/**
 * The photography wall.
 *
 * Every frame in src/assets/shoot is pulled in automatically, so adding work is
 * a matter of dropping exports into the source folder and running `npm run
 * photos`. No frontmatter, no per-image markup.
 *
 * Two rules govern the look:
 *
 *   1. Nothing is cropped. Every frame keeps its native aspect ratio, so a tall
 *      portrait stays tall and a wide frame stays wide. The grid bends around
 *      the photographs rather than the photographs being cut to fit the grid.
 *
 *   2. Favourites lead. They render in their own list above the wall, never
 *      mixed into it and never below it. Both blocks use the same multi-column
 *      masonry and the same gap, so the page reads as one continuous body of
 *      work with the picks simply arriving first.
 *
 *      Edit FAVOURITES to change the picks.
 */

import { Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import Lightbox from '../components/Lightbox.astro';
import ContactFooter from '../components/ContactFooter.astro';

const modules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/shoot/*.{jpg,jpeg,png}',
  { eager: true },
);

/* Filenames carry the shoot they came from. Turning that into a readable label
   gives every frame a usable alt text and a lightbox caption without 71 lines
   of hand-written frontmatter. Frames whose names are only a camera counter
   fall back to a plain description. */
const CAMERA_NOISE = /^(dsc|img|image|untitled)[-_]?\d*$/i;

/* Cole's picks, in the order they should appear. Matched against the
   processed filename (no extension) in src/assets/shoot. */
const FAVOURITES = [
  '2025-london-090',
  '2025-london-237',
  'bjj-champs-2026-25',
  'devpare-17',
  'devpare-18',
  'devpare-38',
  'devpare-50',
  'devpare-56',
  'image-115',
  'image-120',
  'image-193',
  'keis-new-forest-038',
  'keis-new-forest-050',
  'keis-new-forest-055',
  'keis-new-forest-056',
  'photograph-048',
];

function basenameOf(path: string): string {
  return path.split('/').pop()!.replace(/\.[^.]+$/, '');
}

function labelFor(path: string): string {
  const stem = path.split('/').pop()!.replace(/\.[^.]+$/, '');
  const withoutIndex = stem.replace(/-\d+$/, '');

  if (!withoutIndex || CAMERA_NOISE.test(withoutIndex)) {
    return 'Combat sports photography by Cole SJ';
  }

  const words = withoutIndex
    .split('-')
    .filter(Boolean)
    .map((w) => (/^\d+$/.test(w) ? w : w.charAt(0).toUpperCase() + w.slice(1)))
    .join(' ');

  return words;
}

type Shot = {
  src: ImageMetadata;
  alt: string;
  caption: string;
  /* Wide frames earn more room; the rest vary on a fixed rhythm. */
  span: 1 | 2;
};

const shots: Shot[] = Object.entries(modules)
  .sort(([a], [b]) => {
    const ai = FAVOURITES.indexOf(basenameOf(a));
    const bi = FAVOURITES.indexOf(basenameOf(b));

    /* Both favourites: keep FAVOURITES' order. One favourite: it wins.
       Neither: fall back to the original alphabetical order. */
    if (ai !== -1 && bi !== -1) return ai - bi;
    if (ai !== -1) return -1;
    if (bi !== -1) return 1;
    return a.localeCompare(b, 'en', { numeric: true });
  })
  .map(([path, mod]) => {
    const src = mod.default;
    const label = labelFor(path);
    const landscape = src.width > src.height;

    return {
      src,
      alt: label,
      caption: label,
      /* Landscape frames read as squashed at a single column width, so they
         take two. Everything else stays one, which keeps the wall dense. */
      span: (landscape ? 2 : 1) as 1 | 2,
    };
  });

/* One larger variant per frame, generated at build time, so the lightbox costs
   a single request and the grid never has to load a full-size image. */
const fulls = await Promise.all(
  shots.map((shot) =>
    getImage({ src: shot.src, format: 'webp', width: 1800, quality: 82 }),
  ),
);

/* shots is already sorted favourites-first (see the comparator above), so a
   straight slice at FAVOURITES.length splits it into the two display groups
   without needing to re-match filenames. fulls stays index-aligned with shots
   throughout, which is why it is paired here rather than recomputed. */
const paired = shots.map((shot, i) => ({ shot, full: fulls[i] }));
const favourites = paired.slice(0, FAVOURITES.length);
const rest = paired.slice(FAVOURITES.length);
---

<Base
  title="Shoot / Cole SJ"
  description="Combat sports photography by Cole SJ. Boxing, Muay Thai and BJJ, ringside and in the gym."
  ground="corner"
>
  <section class="ph">
    <header class="ph__head">
      <a href="/" class="pill">Back</a>
      <h1 class="ph__title bloom warp-sm">Shoot</h1>
      <p class="ph__count label">{shots.length} frames</p>
    </header>

    <ul class="ph__top">
      {
        favourites.map(({ shot, full }, i) => (
          <li class="ph__top-cell">
            <button
              type="button"
              class="ph__shot"
              data-shot
              data-full={full.src}
              data-alt={shot.alt}
              data-caption={shot.caption}
              aria-label={`Open full size: ${shot.alt}`}
            >
              <Picture
                src={shot.src}
                alt={shot.alt}
                formats={['avif', 'webp']}
                fallbackFormat="jpg"
                widths={[320, 500, 760, 1100]}
                sizes="(min-width: 1100px) 30vw, (min-width: 700px) 45vw, 92vw"
                loading={i < 3 ? 'eager' : 'lazy'}
                decoding="async"
                fetchpriority={i < 3 ? 'high' : 'auto'}
                class="ph__img"
              />
            </button>
          </li>
        ))
      }
    </ul>

    {/* Shuffles the 16 picks on every load, so a repeat visitor never opens the
        same wall twice. Scoped to this list only: the gallery below keeps its
        order, and nothing crosses between the two.

        `is:inline` is doing real work. A normal Astro <script> is bundled as a
        deferred module, which runs after the parser has finished and the page
        has painted, so the reorder would be a visible jump. Inline and
        unbundled, this executes the moment the parser reaches it, while the
        list above is complete but nothing has been painted yet. No layout
        shift, no CLS, ~250 bytes, and no hydration anywhere on the page.

        It also has to beat the lightbox, which snapshots [data-shot] order once
        on init to drive its prev/next. Bundled modules run after inline script,
        so the lightbox reads the shuffled order and its arrows match what is on
        screen.

        With JS off nothing runs and the picks render in their authored order,
        which is a perfectly good page. */}
    <script is:inline>
      (() => {
        const list = document.querySelector('.ph__top');
        if (!list) return;

        const items = [...list.children];
        for (let i = items.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          [items[i], items[j]] = [items[j], items[i]];
        }
        /* append() moves existing nodes rather than copying them, so the
           buttons keep their listeners and the images keep any decode already
           in flight. */
        list.append(...items);

        /* The eager/high hints were baked onto the first three at build time,
           and those three are now somewhere else in the order. Re-point them at
           whichever frames actually lead. */
        items.forEach((li, i) => {
          const img = li.querySelector('img');
          if (!img) return;
          img.loading = i < 3 ? 'eager' : 'lazy';
          img.fetchPriority = i < 3 ? 'high' : 'auto';
        });
      })();
    </script>

    <ul class="ph__grid">
      {
        rest.map(({ shot, full }) => (
          <li class="ph__cell" data-span={shot.span}>
            <button
              type="button"
              class="ph__shot"
              data-shot
              data-full={full.src}
              data-alt={shot.alt}
              data-caption={shot.caption}
              aria-label={`Open full size: ${shot.alt}`}
            >
              <Picture
                src={shot.src}
                alt={shot.alt}
                formats={['avif', 'webp']}
                fallbackFormat="jpg"
                widths={[320, 500, 760, 1100]}
                sizes="(min-width: 1100px) 30vw, (min-width: 700px) 45vw, 92vw"
                loading="lazy"
                decoding="async"
                class="ph__img"
              />
            </button>
          </li>
        ))
      }
    </ul>
  </section>

  <Lightbox />
  <ContactFooter />
</Base>

<style>
  .ph {
    /* One gap value for both blocks, so the favourites and the wall below them
       stay on the same rhythm and read as one body of work. Tightened from
       clamp(0.4rem, 1.2vw, 0.9rem): at 1440px that solved to 14.4px, which set
       the frames apart rather than letting them run together. */
    --ph-gap: clamp(0.3rem, 0.7vw, 0.62rem);

    /* The only deliberate pause on the page: enough to mark where the picks end
       without reading as the page having stopped. Was 48px at 1440px. */
    --ph-block-gap: clamp(0.9rem, 1.6vw, 1.4rem);

    background-color: var(--color-corner);
    padding: var(--spacing-gutter);
    padding-block-end: var(--spacing-room);
  }

  .ph__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 1rem 1.5rem;
    margin-bottom: clamp(2rem, 6vh, 4rem);
  }

  .ph__head a {
    color: inherit;
    text-decoration: none;
    transition:
      background-color 180ms var(--ease-settle),
      color 180ms var(--ease-settle);
  }

  .ph__head a:hover {
    background-color: var(--color-bone);
    color: var(--color-ink);
  }

  .ph__title {
    font-family: var(--font-display);
    font-size: var(--text-step-3);
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    margin: 0;
    margin-inline-end: auto;
  }

  .ph__count {
    opacity: 0.6;
    margin: 0;
  }

  /* Favourites used to be a row-flow CSS Grid, to spread the picks one per
     column instead of stacking them down column one. It did spread them, but
     grid rows are as tall as their tallest cell, so every short frame sat in a
     pocket of dead space: measured at 1440px, gaps inside this block ran to
     347px against the 14px the block actually declared, 1918px of emptiness
     across 16 images. That is what made the page read as separated blocks.

     Multi-column fixes it at the root. Each column is packed independently, so
     a frame's neighbours never dictate its spacing and the only vertical gap is
     the one set here. Column-major reading order is the trade, and it costs
     nothing: these 16 are a set, not a sequence.

     The stacking that made grid necessary in the first place is not a risk
     here. That happened when the favourites were the first 16 of one 85-image
     list, tall enough for column one to swallow them all. With their own
     container, 16 items balance across the three columns. */
  .ph__top {
    list-style: none;
    margin: 0 0 var(--ph-block-gap);
    padding: 0;
    columns: 3;
    column-gap: var(--ph-gap);
  }

  /* Column masonry rather than a row grid, because columns let every frame keep
     its own height. A row grid would force a shared row height and start
     cropping, which is the one thing this page must not do. */
  .ph__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 3;
    column-gap: var(--ph-gap);
  }

  .ph__top-cell,
  .ph__cell {
    break-inside: avoid;
    margin-bottom: var(--ph-gap);
  }

  /* Landscape frames break the column rhythm on purpose. In a wall of mostly
     portrait work they are the thing that stops it reading as a tidy grid. */
  .ph__cell[data-span='2'] {
    column-span: none;
  }

  .ph__shot {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    line-height: 0;
  }

  .ph__img {
    width: 100%;
    height: auto;
    transition:
      opacity 240ms var(--ease-settle),
      filter 240ms var(--ease-settle);
  }

  .ph__shot:hover .ph__img,
  .ph__shot:focus-visible .ph__img {
    opacity: 0.78;
  }

  @media (max-width: 1100px) {
    .ph__top,
    .ph__grid {
      columns: 2;
    }
  }

  @media (max-width: 620px) {
    .ph__top,
    .ph__grid {
      columns: 1;
    }
  }
</style>

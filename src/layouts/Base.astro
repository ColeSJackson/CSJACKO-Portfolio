---
import '../styles/global.css';
/* Preloaded rather than left to the CSS to discover. Both are on the critical
   path for first paint: Groovy sets every heading, Alte Haas Grotesk sets every
   other word on the page plus the digits inside headings. The bold cut is the
   one preloaded, because it is the site default. */
import groovyFont from '../assets/fonts/groovy-madness.woff2?url';
import textFont from '../assets/fonts/alte-haas-bold.woff2?url';
import SiteLogo from '../components/SiteLogo.astro';
import { ClientRouter } from 'astro:transitions';
import Reveal from '../components/Reveal.astro';

interface Props {
  title: string;
  description?: string;
  /**
   * Sets the page ground.
   * `ink` leaves the drifting field visible behind the content.
   * `corner` and `bone` are solid rooms that cover it.
   */
  ground?: 'ink' | 'corner' | 'bone';
  /**
   * The centred CSJACKO mark linking home. On by default so a page added
   * later gets it without anyone remembering to ask; home opts out, because
   * it already opens on the full lockup.
   */
  logo?: boolean;
}

const {
  title,
  description = 'Cole SJ. Content and digital marketing. Photography, video, design and planning for nine powersports brands, and combat sports work as CSJACKO.',
  ground = 'ink',
  logo = true,
} = Astro.props;

/* `ink` is deliberately transparent, not a black fill: the field behind it is
   what supplies the black, and painting over it would hide the drift. */
const GROUND_CLASS = {
  ink: 'text-bone',
  corner: 'bg-corner text-bone',
  bone: 'bg-bone text-ink',
} as const;
---

<!doctype html>
<html lang="en-GB" class={GROUND_CLASS[ground]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="preload"
      href={groovyFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={textFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#0b0b0c" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {/* Turns navigation into a DOM swap, which is what lets the CSJACKO mark
        morph between its two placements instead of the page reloading and the
        mark simply appearing somewhere else. Anything relying on inline script
        must re-init on astro:page-load; Masonry does. */}
    <ClientRouter />
  </head>

  <body class={GROUND_CLASS[ground]}>
    {/* Displacement filters for the display type.

        Turbulence drives a displacement map, which pushes the letterform edges
        around organically. That is what gives the melted, sprayed quality in
        the reference rather than the clean vector edge a font produces.

        Two scales because feDisplacementMap works in absolute pixels: the
        amount that reads as a gentle warp on a 300px mark would destroy a 50px
        section heading. The filter region is oversized so displaced pixels are
        not clipped at the box edge.

        Kept light on purpose. Groovy Madness already has soft, irregular
        letterforms, so the filter is only there to stop repeated characters
        looking identical. Push the scale much past here and the counters in
        C, S, A and O close up and the mark stops being readable.

        This is purely visual. The text underneath stays real text: selectable,
        searchable, and read normally by a screen reader. */}
    <svg class="filters" aria-hidden="true" focusable="false">
      <defs>
        <filter id="warp" x="-15%" y="-25%" width="130%" height="150%">
          <feTurbulence
            type="fractalNoise"
            baseFrequency="0.014 0.021"
            numOctaves="2"
            seed="7"
            result="turb"
          />
          <feDisplacementMap
            in="SourceGraphic"
            in2="turb"
            scale="5"
            xChannelSelector="R"
            yChannelSelector="G"
          />
        </filter>

        <filter id="warp-sm" x="-15%" y="-30%" width="130%" height="160%">
          <feTurbulence
            type="fractalNoise"
            baseFrequency="0.03 0.045"
            numOctaves="2"
            seed="3"
            result="turb"
          />
          <feDisplacementMap
            in="SourceGraphic"
            in2="turb"
            scale="2.2"
            xChannelSelector="R"
            yChannelSelector="G"
          />
        </filter>
      </defs>
    </svg>

    {/* The living ground. Eight oversized blooms drifting on black: two red and
        six white light leaks, each on its own timing so they never visibly
        loop together. Purely decorative, so it is hidden from assistive tech,
        and it only animates transform and opacity so the compositor handles it
        without touching layout or paint. */}
    <div class="field" aria-hidden="true">
      <span class="field__blob field__blob--a"></span>
      <span class="field__blob field__blob--b"></span>
      <span class="field__blob field__blob--c"></span>
      <span class="field__blob field__blob--d"></span>
      <span class="field__blob field__blob--e"></span>
      <span class="field__blob field__blob--f"></span>
      <span class="field__blob field__blob--g"></span>
      <span class="field__blob field__blob--h"></span>
    </div>

    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[70] focus:bg-ink focus:px-4 focus:py-2 focus:text-bone label"
    >
      Skip to content
    </a>

    <Reveal />

    {logo && <SiteLogo />}

    <main id="main">
      <slot />
    </main>
  </body>
</html>

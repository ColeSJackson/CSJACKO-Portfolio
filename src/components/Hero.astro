---
/**
 * The signature hero.
 *
 * Both display lines are solved to the *same measure*, so the mark and the
 * discipline row sit flush on both edges. Groovy Madness is a static font with
 * no width axis, so the fit is done by scaling font-size: the two lines end up
 * at different cap heights, which is what a justified poster stack does and
 * what suits a face this characterful.
 *
 * The four disciplines are the primary navigation. Each word is a real link to
 * its own archive, so the hero is not decoration you scroll past: it is the
 * menu. They share one line rather than getting one each because filling the
 * measure with a single word needs roughly 350px type, and four stacked lines
 * of that do not fit a viewport.
 *
 * The homepage carries no top bar at all: no wordmark, no utility nav. The
 * page opens straight on the logo, and the discipline row below it is the
 * only navigation. Inner pages keep their own header, because none of them
 * have these in-page buttons to navigate by.
 */

import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import colePortrait from '../assets/home/cole-portrait.png';
import coleLandscape from '../assets/home/cole-landscape.png';
import ChalkAnnotation from './ChalkAnnotation.astro';

/* Art direction, not just a resize: two different crops of the same frame, the
   tall one beside the copy on desktop and the wide one above it on a phone.
   <Picture> cannot do this, because it varies width from ONE source; swapping
   the source itself needs a hand-built <picture> with media on the sources.

   The payoff is that the browser picks one branch and downloads only that.
   Rendering both and hiding one with CSS would cost every phone the desktop
   image as well. */
const BIO_SWAP = '(max-width: 640px)';

async function srcset(src: ImageMetadata, format: 'avif' | 'webp', widths: number[]) {
  const built = await Promise.all(
    widths.map((w) => getImage({ src, format, width: w, quality: 82 })),
  );
  return built.map((b, i) => `${b.src} ${widths[i]}w`).join(', ');
}

const portraitWidths = [420, 700, 1080];
const landscapeWidths = [480, 800, 1350];

const bio = {
  portraitAvif: await srcset(colePortrait, 'avif', portraitWidths),
  portraitWebp: await srcset(colePortrait, 'webp', portraitWidths),
  landscapeAvif: await srcset(coleLandscape, 'avif', landscapeWidths),
  landscapeWebp: await srcset(coleLandscape, 'webp', landscapeWidths),
  fallback: await getImage({ src: colePortrait, format: 'jpeg', width: 700, quality: 82 }),
};

/* Each carries its own annotation, and each gets a different arrow: a ruled
   line, a gentle bow, a hook and a long S.

   All four are the SAME length. Shoot's proportion, a short arrow with the
   words right under it, is the one that reads properly, and stretching the
   others to stagger them only pushed their handwriting away from the line it
   belongs to. Variety comes from shape and from where each sits under its
   chip, never from length. */
const DISCIPLINES = [
  {
    word: 'SHOOT',
    href: '/shoot',
    label: 'Photography',
    note: 'My best photos everrr',
    shape: 'curve',
    curve: 34,
    tilt: -6,
    drop: 0,
  },
  {
    word: 'EDIT',
    href: '/edit',
    label: 'Video and reels',
    note: "Some cool videos I've made/edited",
    shape: 'swoop',
    tilt: -3,
    drop: 0,
  },
  {
    word: 'DESIGN',
    href: '/design',
    label: 'Paid social, email and print design',
    note: 'emails, paid media and more sick designs :)',
    shape: 'straight',
    tilt: -9,
    drop: 0,
  },
  {
    word: 'STRATEGY',
    href: '/strategy',
    label: 'Planning and content strategy',
    note: "Social Media and Email Marketing strategy's inside! (They're really good)",
    shape: 'hook',
    tilt: -4,
    drop: 0,
  },
];
---

<section class="hero">
  <div class="hero__stack" data-fit-group>
    <h1
      class="lockup bloom warp hero__mark"
      data-fit
      style="--i:0"
      transition:name="site-mark"
    >
      CSJACKO
    </h1>

    <nav class="hero__disciplines" aria-label="Work by discipline">
      <p class="lockup hero__row" data-fit style="--i:1">
        {
          DISCIPLINES.map((d) => (
            /* The annotation lives inside its own chip, so it hangs off THAT
               button rather than off the row. Percentages against the row would
               drift the moment the fit solver changed its width, and drift
               differently at every breakpoint.

               It goes inside the anchor rather than in a wrapper around it: a
               wrapper adds a flex item the solver then measures, which threw
               the whole lockup out. Nested here it is absolutely positioned and
               out of flow, so the row measures exactly as it did before. It is
               aria-hidden and pointer-events:none, so it adds nothing to the
               link's name and cannot intercept its clicks. */
            <a class="hero__word" href={d.href} aria-label={d.label}>
              {d.word}
              <ChalkAnnotation
                target={`${d.word} button`}
                text={d.note}
                shape={d.shape}
                curve={d.curve}
                tilt={d.tilt}
                drop={d.drop}
                side="left"
              />
            </a>
          ))
        }
      </p>
    </nav>
  </div>

  <div class="hero__foot">
    {/* Copy left, portrait right. The card is the only rounded, bordered
        surface on the homepage, which is what lets it hold the two halves
        together as one object rather than a paragraph beside a picture. */}
    <div class="bio">
      <div class="bio__copy">
        <p class="text-pretty">
          Hey I&rsquo;m Cole! I&rsquo;m a super creative and bubbly Content and
          Digital Marketing Executive. I currently work for Motohaus
          Powersports, and their portfolio of 9 Motorcycle accessory brands.
          Outside of my full time work, I run a freelance side hustle where I do
          event/sport photography.
        </p>
        <p class="text-pretty">
          I&rsquo;m happiest when I have creative freedom, Check out my portfolio
          while you&rsquo;re here!
        </p>
        <p class="bio__sign">- Cole SJ</p>
      </div>

      <div class="bio__portrait">
        <picture>
          {/* Phone first: the media-qualified sources have to precede the
              unqualified ones, because a browser takes the first source that
              matches and never looks further. */}
          <source
            media={BIO_SWAP}
            type="image/avif"
            srcset={bio.landscapeAvif}
            sizes="92vw"
          />
          <source
            media={BIO_SWAP}
            type="image/webp"
            srcset={bio.landscapeWebp}
            sizes="92vw"
          />
          <source type="image/avif" srcset={bio.portraitAvif} sizes="34vw" />
          <source type="image/webp" srcset={bio.portraitWebp} sizes="34vw" />
          <img
            src={bio.fallback.src}
            alt="Cole taking a mirror selfie on a compact film camera, throwing a peace sign."
            width={bio.fallback.attributes?.width ?? 700}
            height={bio.fallback.attributes?.height ?? 875}
            loading="eager"
            decoding="async"
            class="bio__img"
          />
        </picture>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    gap: clamp(1.25rem, 3vh, 2.25rem);
    padding: var(--spacing-gutter);
    padding-bottom: clamp(0.75rem, 2vh, 1.5rem);
  }

  /* The lockup and the paragraph read as one block, sitting low in the hero.
     All the spare height collects above them: put any of it below and it lands
     between the paragraph and the first row of work, where it reads as the page
     having stopped rather than as breathing room. */
  .hero__stack {
    margin-top: auto;
  }

  .hero__stack {
    width: 100%;
  }

  /* Shrink-to-fit is load-bearing: the solver measures offsetWidth, which on a
     full-width block would just report the container. */
  .hero__mark,
  .hero__row {
    width: max-content;
    max-width: none;
    white-space: nowrap;
    /* When the solver runs, each line is exactly the container width and this
       does nothing. When it has not run yet, or cannot, the line is narrower
       than the container and max-content would pin it to the left edge. This
       makes the unsolved state centred instead, so the failure mode is "not
       quite fitted" rather than "visibly shoved left". */
    margin-inline: auto;

    /* Entrance is pure CSS and depends on nothing. If the fit script never
       runs, the lines still arrive, just unfitted, rather than staying
       invisible. Transform and opacity only, so it stays on the compositor. */
    animation: lockup-in 800ms var(--ease-settle) backwards;
    animation-delay: calc(var(--i) * 110ms);
  }

  @keyframes lockup-in {
    from {
      opacity: 0;
      transform: translateY(0.1em);
    }
  }

  .hero__mark {
    /* --fit-scale is written by the solver only when the axis runs out, which
       is what stops a long line overflowing on a narrow phone. */
    font-size: calc(clamp(3rem, 21vw, 19rem) * var(--fit-scale, 1));
    color: var(--color-flare);
    line-height: 0.8;
  }

  .hero__disciplines {
    margin-top: clamp(0.4rem, 1.2vh, 0.9rem);
    /* The annotation positions against this, which is the box the buttons
       live in, so it tracks them rather than the window. */
    position: relative;
  }

  /* Sits under its own chip with the arrow curving up into it, so it points at
     the button rather than crossing over it.

     :global is required, not stylistic. Astro scopes styles by stamping this
     component's id onto elements in THIS template; the annotation's root
     element carries the annotation component's id instead, so a plain selector
     here compiles to one that matches nothing and the offsets silently never
     apply. Scoping the parent and globalling the child gives the rule
     something real to match. */
  .hero__word :global(.chalk) {
    left: 0;
    top: 100%;
    margin-top: -0.5rem;
  }

  /* Variety by position, not by length. Each annotation sits at a different
     point under its own chip, which breaks the row up without stretching any
     arrow away from its words. */
  .hero__word:nth-child(2) :global(.chalk) {
    left: 22%;
  }

  .hero__word:nth-child(3) :global(.chalk) {
    left: 8%;
  }

  .hero__word:nth-child(4) :global(.chalk) {
    left: 28%;
  }


  .hero__row {
    font-size: calc(clamp(0.85rem, 4.1vw, 3.4rem) * var(--fit-scale, 1));
    color: var(--color-bone);
    line-height: 1.1;
    letter-spacing: 0;

    /* Chips have their own padding, so the gap only needs to separate their
       outlines rather than the words themselves. */
    display: flex;
    gap: 0.22em;
  }

  /* Each discipline is a target, and has to look like one at rest. A hover-only
     underline is invisible to anyone who never hovers, and invisible to every
     touch device, so these carry a permanent outline instead.

     Every value is in em so the whole chip scales with the fit solver. Using px
     for the padding or the border would make the buttons drift out of
     proportion at each viewport as the font-size is solved. */
  /* Filled red at rest, deep green on hover. The fill is the affordance now,
     so the border only exists to keep the chip's edge crisp against the
     background and matches whichever fill is showing. */
  .hero__word {
    position: relative;
    color: var(--color-bone);
    text-decoration: none;
    padding: 0.24em 0.4em 0.3em;
    background-color: var(--color-flare);
    /* Floored at 1px. Purely em-based, the border solves to 0.5px on a phone
       where the fitted font-size is small, and a half-pixel hairline is the
       same as no affordance at all. The em value still governs at large
       sizes. */
    border: max(1px, 0.045em) solid var(--color-flare);
    border-radius: 0.32em;
    /* Long enough to read as a wash rather than a swap. Red to blue is most of
       the way round the wheel, so a short transition reads as a flicker. */
    transition:
      background-color 320ms var(--ease-settle),
      border-color 320ms var(--ease-settle),
      color 320ms var(--ease-settle);
  }

  .hero__word:hover,
  .hero__word:focus-visible {
    background-color: var(--color-sky);
    border-color: var(--color-sky);
    /* Bone on this blue is roughly 1.6:1. Ink is 11:1, so the label flips
       dark rather than staying pale and washing out. */
    color: var(--color-ink);
  }

  .hero__foot {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 2rem;

    /* Sized to clear the annotations, not just to separate the two registers.
       Four chalk notes hang below the row and the staggered ones reach roughly
       170px past it, so anything less and the handwriting lands on top of the
       card. */
    margin-top: clamp(5rem, 11vh, 8rem);
  }

  .bio {
    display: grid;
    /* Copy takes the larger share; the portrait is a companion, not a hero
       image. */
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    width: 100%;
    max-width: 62rem;
    margin: 0 auto;
    padding: clamp(1.25rem, 2.5vw, 2rem);
    border-radius: clamp(1rem, 2vw, 1.5rem);
    background-color: color-mix(in srgb, var(--color-corner) 82%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-bone) 14%, transparent);
    /* The card sits over the drifting field, so it needs to sit on something
       rather than let the blooms run through the copy. */
    backdrop-filter: blur(6px);
  }

  .bio__copy {
    font-size: var(--text-step-1);
    color: var(--color-bone);
    opacity: 0.85;
    text-align: left;
  }

  .bio__copy p {
    margin: 0;
  }

  .bio__copy p + p {
    margin-top: 0.9em;
  }

  .bio__sign {
    margin-top: 1.1em !important;
    opacity: 0.7;
  }

  /* 4:5 portrait, the same ratio the case study covers use. The ratio is fixed
     and the image covers it, so a re-crop later changes what you see inside the
     frame without moving anything around it. */
  .bio__portrait {
    /* 4:5 is the portrait crop's own ratio, so the frame never cuts it. */
    aspect-ratio: 4 / 5;
    border-radius: clamp(0.75rem, 1.5vw, 1.1rem);
    background-color: var(--color-corner-lift);
    overflow: hidden;
  }

  .bio__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Same clearance problem on a phone, and it was overriding the desktop value
     with a smaller one. The stagger tightens here too: the chips are narrow
     enough that a shorter drop still keeps neighbours apart. */
  @media (max-width: 768px) {
    .hero__foot {
      margin-top: clamp(8.5rem, 20vh, 11rem);
    }

  }

  /* All four stay on a phone now that the cascade above separates them
     vertically. They need more room below to land in. */
  @media (max-width: 700px) {
    .hero__foot {
      margin-top: clamp(6rem, 14vh, 8.5rem);
    }

    /* The drop is in viewBox units, so it scales with the annotation's width:
       on a narrow screen the arrows shorten and the cascade tightens with them
       until two of the text blocks meet. A small extra offset here restores the
       separation without pulling the handwriting off the end of its line. */
    /* The horizontal offsets are what break the row up on a wide screen, but
       on a phone the chips are narrow enough that shifting a note sideways
       pushes it straight into its neighbour. Each goes back under its own chip
       and the vertical cascade does the separating instead. */
    .hero__word:nth-child(2) :global(.chalk),
    .hero__word:nth-child(3) :global(.chalk),
    .hero__word:nth-child(4) :global(.chalk) {
      left: 0;
    }

    /* Only a hair of stagger. Pushing the handwriting far enough down to clear
       a whole neighbouring block is what detached it from its arrow, which is
       the worse fault: an annotation whose words have floated away from its
       line has stopped being an annotation. Separation comes from each note
       being narrow enough to sit under its own chip instead. */
    .hero__word:nth-child(2) :global(.chalk__text) {
      margin-top: 0.35rem;
    }

    .hero__word:nth-child(3) :global(.chalk__text) {
      margin-top: 0.7rem;
    }

    .hero__word:nth-child(4) :global(.chalk__text) {
      margin-top: 1.05rem;
    }
  }

  @media (max-width: 640px) {
    .bio {
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
    }

    /* Portrait leads on a phone: the card is taller than the screen otherwise
       and the photograph never gets seen. */
    .bio__portrait {
      order: -1;
      /* 5:4, the landscape crop's own ratio, for the same reason. This
         breakpoint has to match BIO_SWAP or the frame and the file it is
         holding would disagree about shape. */
      aspect-ratio: 5 / 4;
    }

    /* No forced full height on a phone.

       The lockup is fitted to the viewport *width*, so on a tall narrow screen
       it can only ever be so tall, and holding the hero at 100svh just parks
       190px of nothing above and below it. Letting the hero take its content
       height removes the void, and the work starting to show at the bottom of
       the screen is a better invitation to scroll than emptiness is. */
    .hero {
      min-height: auto;
      padding-block: clamp(1.25rem, 4vh, 2rem) clamp(0.5rem, 2vh, 1rem);
    }

    .hero__stack {
      margin-top: clamp(2rem, 8vh, 4rem);
    }

    .hero__foot {
      margin-bottom: 0;
    }
  }
</style>

<script>
  import { initFit } from '../scripts/fit-lines';

  initFit();
</script>

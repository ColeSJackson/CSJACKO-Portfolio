---
/**
 * The signature hero.
 *
 * Both display lines are solved to the *same measure*, so the mark and the
 * discipline row sit flush on both edges. Groovy Madness is a static font with
 * no width axis, so the fit is done by scaling font-size: the two lines end up
 * at different cap heights, which is what a justified poster stack does and
 * what suits a face this characterful.
 *
 * The four disciplines are the primary navigation. Each word is a real link to
 * its own archive, so the hero is not decoration you scroll past: it is the
 * menu. They share one line rather than getting one each because filling the
 * measure with a single word needs roughly 350px type, and four stacked lines
 * of that do not fit a viewport.
 *
 * The homepage carries no top bar at all: no wordmark, no utility nav. The
 * page opens straight on the logo, and the discipline row below it is the
 * only navigation. Inner pages keep their own header, because none of them
 * have these in-page buttons to navigate by.
 */

import { Picture } from 'astro:assets';
import colePortrait from '../assets/home/cole-portrait.jpg';
import ChalkAnnotation from './ChalkAnnotation.astro';

const DISCIPLINES = [
  { word: 'SHOOT', href: '/shoot', label: 'Photography' },
  { word: 'EDIT', href: '/edit', label: 'Video and reels' },
  { word: 'DESIGN', href: '/design', label: 'Paid social, email and print design' },
  { word: 'STRATEGY', href: '/strategy', label: 'Planning and content strategy' },
];
---

<section class="hero">
  <div class="hero__stack" data-fit-group>
    <h1
      class="lockup bloom warp hero__mark"
      data-fit
      style="--i:0"
      transition:name="site-mark"
    >
      CSJACKO
    </h1>

    <nav class="hero__disciplines" aria-label="Work by discipline">
      {/* Anchored to the discipline row, not the viewport, so it stays on the
          Shoot button at every width. */}
      <ChalkAnnotation
        target="Shoot button"
        text="My best photos everrr"
        curve={34}
        side="left"
        class="hero__chalk"
      />

      <p class="lockup hero__row" data-fit style="--i:1">
        {
          DISCIPLINES.map((d) => (
            <a class="hero__word" href={d.href} aria-label={d.label}>
              {d.word}
            </a>
          ))
        }
      </p>
    </nav>
  </div>

  <div class="hero__foot">
    {/* Copy left, portrait right. The card is the only rounded, bordered
        surface on the homepage, which is what lets it hold the two halves
        together as one object rather than a paragraph beside a picture. */}
    <div class="bio">
      <div class="bio__copy">
        <p class="text-pretty">
          Hey I&rsquo;m Cole! I&rsquo;m a super creative and bubbly Content and
          Digital Marketing Executive. I currently work for Motohaus
          Powersports, and their portfolio of 9 Motorcycle accessory brands.
          Outside of my full time work, I run a freelance side hustle where I do
          event/sport photography.
        </p>
        <p class="text-pretty">
          I&rsquo;m happiest when I have creative freedom, Check out my portfolio
          while you&rsquo;re here!
        </p>
        <p class="bio__sign">- Cole SJ</p>
      </div>

      <div class="bio__portrait">
        <Picture
          src={colePortrait}
          alt="Cole shooting on a Sony body, with a collage of him holding a film camera and pulling a face to camera."
          formats={['avif', 'webp']}
          fallbackFormat="jpg"
          widths={[400, 700, 1000, 1400]}
          sizes="(min-width: 900px) 34vw, 92vw"
          loading="eager"
          decoding="async"
          class="bio__img"
        />
      </div>
    </div>

    <p class="label hero__scroll" aria-hidden="true">Scroll</p>
  </div>
</section>

<style>
  .hero {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    gap: clamp(1.25rem, 3vh, 2.25rem);
    padding: var(--spacing-gutter);
    padding-bottom: clamp(0.75rem, 2vh, 1.5rem);
  }

  /* The lockup and the paragraph read as one block, sitting low in the hero.
     All the spare height collects above them: put any of it below and it lands
     between the paragraph and the first row of work, where it reads as the page
     having stopped rather than as breathing room. */
  .hero__stack {
    margin-top: auto;
  }

  .hero__stack {
    width: 100%;
  }

  /* Shrink-to-fit is load-bearing: the solver measures offsetWidth, which on a
     full-width block would just report the container. */
  .hero__mark,
  .hero__row {
    width: max-content;
    max-width: none;
    white-space: nowrap;
    /* When the solver runs, each line is exactly the container width and this
       does nothing. When it has not run yet, or cannot, the line is narrower
       than the container and max-content would pin it to the left edge. This
       makes the unsolved state centred instead, so the failure mode is "not
       quite fitted" rather than "visibly shoved left". */
    margin-inline: auto;

    /* Entrance is pure CSS and depends on nothing. If the fit script never
       runs, the lines still arrive, just unfitted, rather than staying
       invisible. Transform and opacity only, so it stays on the compositor. */
    animation: lockup-in 800ms var(--ease-settle) backwards;
    animation-delay: calc(var(--i) * 110ms);
  }

  @keyframes lockup-in {
    from {
      opacity: 0;
      transform: translateY(0.1em);
    }
  }

  .hero__mark {
    /* --fit-scale is written by the solver only when the axis runs out, which
       is what stops a long line overflowing on a narrow phone. */
    font-size: calc(clamp(3rem, 21vw, 19rem) * var(--fit-scale, 1));
    color: var(--color-flare);
    line-height: 0.8;
  }

  .hero__disciplines {
    margin-top: clamp(0.4rem, 1.2vh, 0.9rem);
    /* The annotation positions against this, which is the box the buttons
       live in, so it tracks them rather than the window. */
    position: relative;
  }

  /* Sits above and left of the row, arrow curving down into the Shoot chip.
     Percentages, so it follows the row as the fit solver resizes it. */
  .hero__chalk {
    left: -1%;
    bottom: 100%;
    margin-bottom: -0.4rem;
  }

  .hero__row {
    font-size: calc(clamp(0.85rem, 4.1vw, 3.4rem) * var(--fit-scale, 1));
    color: var(--color-bone);
    line-height: 1.1;
    letter-spacing: 0;

    /* Chips have their own padding, so the gap only needs to separate their
       outlines rather than the words themselves. */
    display: flex;
    gap: 0.22em;
  }

  /* Each discipline is a target, and has to look like one at rest. A hover-only
     underline is invisible to anyone who never hovers, and invisible to every
     touch device, so these carry a permanent outline instead.

     Every value is in em so the whole chip scales with the fit solver. Using px
     for the padding or the border would make the buttons drift out of
     proportion at each viewport as the font-size is solved. */
  /* Filled red at rest, deep green on hover. The fill is the affordance now,
     so the border only exists to keep the chip's edge crisp against the
     background and matches whichever fill is showing. */
  .hero__word {
    color: var(--color-bone);
    text-decoration: none;
    padding: 0.24em 0.4em 0.3em;
    background-color: var(--color-flare);
    /* Floored at 1px. Purely em-based, the border solves to 0.5px on a phone
       where the fitted font-size is small, and a half-pixel hairline is the
       same as no affordance at all. The em value still governs at large
       sizes. */
    border: max(1px, 0.045em) solid var(--color-flare);
    border-radius: 0.32em;
    /* Long enough to read as a wash rather than a swap. Red to blue is most of
       the way round the wheel, so a short transition reads as a flicker. */
    transition:
      background-color 320ms var(--ease-settle),
      border-color 320ms var(--ease-settle),
      color 320ms var(--ease-settle);
  }

  .hero__word:hover,
  .hero__word:focus-visible {
    background-color: var(--color-sky);
    border-color: var(--color-sky);
    /* Bone on this blue is roughly 1.6:1. Ink is 11:1, so the label flips
       dark rather than staying pale and washing out. */
    color: var(--color-ink);
  }

  .hero__foot {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 2rem;

    /* Replaces the separation the byline used to provide. Without it the body
       copy sits directly under the display row with only the hero's own gap
       between them, and the two registers run together. */
    margin-top: clamp(1.25rem, 3.5vh, 2.75rem);
  }

  .bio {
    display: grid;
    /* Copy takes the larger share; the portrait is a companion, not a hero
       image. */
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    width: 100%;
    max-width: 62rem;
    margin: 0 auto;
    padding: clamp(1.25rem, 2.5vw, 2rem);
    border-radius: clamp(1rem, 2vw, 1.5rem);
    background-color: color-mix(in srgb, var(--color-corner) 82%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-bone) 14%, transparent);
    /* The card sits over the drifting field, so it needs to sit on something
       rather than let the blooms run through the copy. */
    backdrop-filter: blur(6px);
  }

  .bio__copy {
    font-size: var(--text-step-1);
    color: var(--color-bone);
    opacity: 0.85;
    text-align: left;
  }

  .bio__copy p {
    margin: 0;
  }

  .bio__copy p + p {
    margin-top: 0.9em;
  }

  .bio__sign {
    margin-top: 1.1em !important;
    opacity: 0.7;
  }

  /* 4:5 portrait, the same ratio the case study covers use. The ratio is fixed
     and the image covers it, so a re-crop later changes what you see inside the
     frame without moving anything around it. */
  .bio__portrait {
    aspect-ratio: 4 / 5;
    border-radius: clamp(0.75rem, 1.5vw, 1.1rem);
    background-color: var(--color-corner-lift);
    overflow: hidden;
  }

  .bio__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__scroll {
    position: absolute;
    right: 0;
    bottom: 0;
    color: var(--color-flare);
    writing-mode: vertical-rl;
    margin: 0;
  }

  @media (max-width: 640px) {
    .hero__scroll {
      display: none;
    }

    .bio {
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
    }

    /* Portrait leads on a phone: the card is taller than the screen otherwise
       and the photograph never gets seen. */
    .bio__portrait {
      order: -1;
      aspect-ratio: 16 / 10;
    }

    /* No forced full height on a phone.

       The lockup is fitted to the viewport *width*, so on a tall narrow screen
       it can only ever be so tall, and holding the hero at 100svh just parks
       190px of nothing above and below it. Letting the hero take its content
       height removes the void, and the work starting to show at the bottom of
       the screen is a better invitation to scroll than emptiness is. */
    .hero {
      min-height: auto;
      padding-block: clamp(1.25rem, 4vh, 2rem) clamp(0.5rem, 2vh, 1rem);
    }

    .hero__stack {
      margin-top: clamp(2rem, 8vh, 4rem);
    }

    .hero__foot {
      margin-bottom: 0;
    }
  }
</style>

<script>
  import { initFit } from '../scripts/fit-lines';

  initFit();
</script>

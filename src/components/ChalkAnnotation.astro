---
/**
 * A hand-drawn chalk arrow with handwriting, pointing at something on the page.
 *
 * Positioned against its nearest positioned ancestor, not the viewport, so it
 * tracks whatever it points at through every breakpoint. Put it inside the
 * container that holds the target and give that container `position: relative`.
 *
 * It is decoration in the strict sense: `aria-hidden` and `pointer-events:
 * none`, so it never enters the tab order, never gets read out, and cannot
 * intercept a hover or a click on the thing it is pointing at. That last part
 * matters here, because it overlaps the discipline buttons and those have a
 * hover state that must keep working.
 *
 * The chalk texture is a real filter, not an image: turbulence driving a
 * displacement map roughs the stroke edge, and a second wide, faint copy of the
 * same path underneath reads as the dust a chalk line leaves behind. Round caps
 * and joins because chalk has no sharp corners.
 */

interface Props {
  /** For the comment in the markup. The component does not query the DOM. */
  target?: string;
  text: string;
  /** How much the arrow bows. Only used by the `curve` shape. */
  curve?: number;
  /** Which arrow to draw. See SHAPES below. */
  shape?: 'straight' | 'curve' | 'hook' | 'swoop';
  /** Rotation of the handwriting, in degrees. Varied so no two match. */
  tilt?: number;
  /**
   * How far the arrow's tail reaches below its tip, in viewBox units.
   * This is what staggers a row of annotations: the tip stays pinned to the
   * target and the LINE gets longer, so the handwriting travels down with the
   * tail it is attached to. Offsetting the text on its own instead leaves it
   * stranded in space with a gap between it and its arrow.
   */
  drop?: number;
  /** Which side of the target it sits on. Flips the whole thing horizontally. */
  side?: 'left' | 'right';
  /** Extra classes for placement against the parent. */
  class?: string;
}

const {
  target = '',
  text,
  curve = 40,
  shape = 'curve',
  tilt = -6,
  drop = 0,
  side = 'left',
  class: className = '',
} = Astro.props;

/* One id per instance, so two annotations on a page cannot share a filter. */
const uid = `chalk-${Math.random().toString(36).slice(2, 8)}`;

/* Four genuinely different arrows, not one arrow with a dial on it.

   All are drawn in the same 200x130 box and all finish near the top right, so
   whichever is used still approaches its target from below and points up into
   it. What changes is the geometry between: a straight rule, a gentle bow, a
   hook that swings out left before coming back, and a long lazy S. Varying a
   single control point, which is what this did before, only ever produced the
   same shape bent by different amounts, and four of those in a row read as
   clones.

   Each carries its own arrowhead because the tangent at the tip differs per
   shape, and a head that ignores the direction of travel looks stuck on. The
   head is part of the same path, so the whole mark still draws as one line. */
const SHAPES = {
  /* A ruled line. No bow at all. */
  straight: `M 22 ${118 + drop} L 128 22 M 128 22 L 101 28 M 128 22 L 122 49`,

  /* The original gentle bow, still driven by `curve`. */
  curve: `M 14 ${122 + drop} Q ${34 + curve} ${96 - curve + drop * 0.55} 130 20 M 130 20 L 104 27 M 130 20 L 124 46`,

  /* Swings out to the left before hooking back up. */
  hook: `M 46 ${126 + drop} C 2 ${104 + drop}, 16 ${44 + drop * 0.35}, 124 18 M 124 18 L 97 21 M 124 18 L 119 45`,

  /* A long shallow S, the loosest of the four. */
  swoop: `M 8 ${116 + drop} C 72 ${126 + drop}, 22 ${52 + drop * 0.4}, 126 20 M 126 20 L 99 25 M 126 20 L 120 47`,
} as const;

const d = SHAPES[shape];

/* The box grows with the drop, so a longer tail is drawn at the same scale
   rather than the whole arrow being squashed to fit a fixed box. */
const vbHeight = 130 + drop;
---

{/* A span, not a div, and that matters. This gets nested inside the hero's
    discipline chips, which live in a <p>. The HTML parser closes an open <p>
    the moment it meets a block-level start tag, so a <div> root here silently
    shattered the row into fragments and the lockup came apart. A span carries
    display:flex just as well and keeps the paragraph intact. */}
<span
  class:list={['chalk', `chalk--${side}`, className]}
  aria-hidden="true"
  data-chalk
  data-target={target}
  style={`--tilt:${tilt}deg`}
>
  <svg class="chalk__svg" viewBox={`0 0 200 ${vbHeight}`} fill="none" focusable="false">
    <defs>
      <filter id={uid} x="-20%" y="-20%" width="140%" height="140%">
        <feTurbulence
          type="fractalNoise"
          baseFrequency="0.9"
          numOctaves="3"
          seed="5"
          result="n"
        />
        <feDisplacementMap
          in="SourceGraphic"
          in2="n"
          scale="2.4"
          xChannelSelector="R"
          yChannelSelector="G"
        />
      </filter>
    </defs>

    {/* The dust: same path, much wider and very faint, sitting under the line. */}
    <path class="chalk__dust" d={d} filter={`url(#${uid})`} />
    <path class="chalk__line" d={d} filter={`url(#${uid})`} />
  </svg>

  <span class="chalk__text">{text}</span>
</span>

<style>
  .chalk {
    position: absolute;
    /* Never a click target, and never in the way of one. Without this the
       arrow's own box would sit over the buttons and eat their hover. */
    pointer-events: none;
    z-index: 3;
    display: flex;
    /* Arrow first, handwriting under it. The arrow is the half that has to
       touch the target, so it takes the edge nearest it. */
    flex-direction: column;
    align-items: flex-start;
    gap: 0.15rem;
    width: clamp(6rem, 8.5vw, 8.5rem);
  }

  .chalk--right {
    /* Mirrors the arrow so it can approach from the other side. The text is
       un-mirrored below, or it would read backwards. */
    transform: scaleX(-1);
  }

  .chalk--right .chalk__text {
    transform: scaleX(-1) rotate(var(--tilt, -6deg));
    align-self: flex-end;
  }

  .chalk__svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .chalk__line,
  .chalk__dust {
    fill: none;
    stroke: #f2efe6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .chalk__line {
    stroke-width: 3.2;
    opacity: 0.85;
  }

  /* Wide and faint: this is what stops the stroke reading as a clean vector
     line and starts it reading as something pressed onto a surface. */
  .chalk__dust {
    stroke-width: 7;
    opacity: 0.14;
  }

  .chalk__text {
    /* Both load-bearing. align-items:flex-start makes flex children
       shrink-to-fit, and the hero row this now sits inside sets
       white-space:nowrap, which the handwriting inherits. Either one alone
       leaves it setting on a single long line that runs across its neighbours
       rather than wrapping to the annotation. */
    width: 100%;
    white-space: normal;
    font-family: 'Caveat', sans-serif;
    font-weight: 600;
    font-size: clamp(0.8rem, 1.3vw, 1.05rem);
    line-height: 1.05;
    color: #f2efe6;
    opacity: 0.85;
    transform: rotate(var(--tilt, -6deg));
    transform-origin: left center;
    padding-inline-start: 0.4rem;
  }

  /* Draw-on. The dash pattern is set long enough to cover the whole path, then
     the offset is animated to zero so the line appears to be drawn.

     Delayed past the hero's own entrance: the lockup animates in over 800ms
     with a 110ms stagger, so this starts after that has resolved rather than
     competing with it. */
  @media (prefers-reduced-motion: no-preference) {
    .chalk__line,
    .chalk__dust {
      stroke-dasharray: 640;
      stroke-dashoffset: 640;
      animation: chalk-draw 900ms var(--ease-settle) 1150ms forwards;
    }

    .chalk__text {
      opacity: 0;
      animation: chalk-fade 500ms var(--ease-settle) 1900ms forwards;
    }
  }

  @keyframes chalk-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes chalk-fade {
    to {
      opacity: 0.85;
    }
  }

  /* Under reduced motion there is no draw-on at all: the annotation is simply
     already there, which is the honest reading of that setting. */
  @media (prefers-reduced-motion: reduce) {
    .chalk__line,
    .chalk__dust,
    .chalk__text {
      animation: none;
    }
  }

  /* It sits under the row rather than beside it, so a phone needs no special
     case beyond size: the stack is the same, just smaller. Scaled down and
     nudged in so the arrow still lands under the first button on a narrow
     screen instead of running past it. */
  @media (max-width: 768px) {
    .chalk {
      width: 5.2rem;
      gap: 0;
    }

    .chalk__text {
      font-size: 0.68rem;
    }
  }

  /* No lower cut-off. It used to hide under 380px, which took it off the
     narrower phones entirely; the hero foot already carries the clearance it
     needs, so it just gets smaller instead. */
  @media (max-width: 420px) {
    .chalk {
      width: 4.6rem;
    }

    .chalk__text {
      font-size: 0.62rem;
    }
  }
</style>

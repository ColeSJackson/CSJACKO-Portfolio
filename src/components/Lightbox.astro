---
/**
 * Detail view without navigating away from the flow.
 *
 * Uses a native <dialog>, which gives focus trapping, Escape to close and
 * inert-ing of the page behind it for free. One <img> is swapped rather than
 * rendering every full-size image up front.
 */
---

<dialog class="lb" data-lightbox aria-label="Image viewer">
  <div class="lb__bar">
    <p class="label lb__counter" data-lb-counter></p>
    <button type="button" class="lb__close pill" data-lb-close>Close</button>
  </div>

  <figure class="lb__figure">
    <img class="lb__img" data-lb-img alt="" />
    <figcaption class="lb__caption label" data-lb-caption></figcaption>
  </figure>

  <button
    type="button"
    class="lb__nav lb__nav--prev"
    data-lb-prev
    aria-label="Previous image"
  >
    <span aria-hidden="true">&#8592;</span>
  </button>
  <button
    type="button"
    class="lb__nav lb__nav--next"
    data-lb-next
    aria-label="Next image"
  >
    <span aria-hidden="true">&#8594;</span>
  </button>
</dialog>

<style>
  .lb {
    width: 100vw;
    max-width: 100vw;
    height: 100svh;
    max-height: 100svh;
    margin: 0;
    padding: 0;
    border: 0;
    background-color: var(--color-corner);
    color: var(--color-bone);
    overflow: hidden;
  }

  .lb::backdrop {
    background-color: color-mix(in srgb, var(--color-ink) 92%, transparent);
  }

  .lb__bar {
    position: absolute;
    inset-inline: 0;
    top: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: var(--spacing-gutter);
  }

  .lb__counter {
    margin: 0;
    opacity: 0.7;
  }

  .lb__close {
    background: none;
    color: var(--color-bone);
    cursor: pointer;
    transition:
      background-color 180ms var(--ease-settle),
      color 180ms var(--ease-settle);
  }

  .lb__close:hover {
    background-color: var(--color-bone);
    color: var(--color-ink);
  }

  .lb__figure {
    margin: 0;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: calc(var(--spacing-gutter) * 2.5) var(--spacing-gutter);
  }

  .lb__img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .lb__caption {
    margin: 0;
    max-width: 60ch;
    text-align: center;
    opacity: 0.7;
    text-transform: none;
    letter-spacing: 0.04em;
  }

  .lb__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    width: 3rem;
    height: 3rem;
    display: grid;
    place-items: center;
    background: none;
    border: 1px solid currentColor;
    border-radius: 999px;
    color: var(--color-bone);
    font-size: 1.1rem;
    cursor: pointer;
    transition:
      background-color 180ms var(--ease-settle),
      color 180ms var(--ease-settle);
  }

  .lb__nav:hover {
    background-color: var(--color-bone);
    color: var(--color-ink);
  }

  .lb__nav--prev {
    left: var(--spacing-gutter);
  }

  .lb__nav--next {
    right: var(--spacing-gutter);
  }

  @media (max-width: 640px) {
    .lb__nav {
      top: auto;
      bottom: var(--spacing-gutter);
      transform: none;
    }
  }
</style>

<script>
  interface Shot {
    full: string;
    alt: string;
    caption: string;
  }

  function init() {
    const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
    const triggers = Array.from(
      document.querySelectorAll<HTMLButtonElement>('[data-shot]'),
    );
    if (!dialog || !triggers.length) return;

    const img = dialog.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const caption = dialog.querySelector<HTMLElement>('[data-lb-caption]')!;
    const counter = dialog.querySelector<HTMLElement>('[data-lb-counter]')!;

    const shots: Shot[] = triggers.map((t) => ({
      full: t.dataset.full ?? '',
      alt: t.dataset.alt ?? '',
      caption: t.dataset.caption ?? '',
    }));

    let current = 0;
    let opener: HTMLElement | null = null;

    function show(i: number) {
      current = (i + shots.length) % shots.length;
      const shot = shots[current];
      img.src = shot.full;
      img.alt = shot.alt;
      caption.textContent = shot.caption;
      counter.textContent = `${String(current + 1).padStart(2, '0')} / ${String(shots.length).padStart(2, '0')}`;
    }

    triggers.forEach((trigger, i) => {
      trigger.addEventListener('click', () => {
        opener = trigger;
        show(i);
        dialog.showModal();
      });
    });

    dialog
      .querySelector('[data-lb-close]')!
      .addEventListener('click', () => dialog.close());
    dialog
      .querySelector('[data-lb-prev]')!
      .addEventListener('click', () => show(current - 1));
    dialog
      .querySelector('[data-lb-next]')!
      .addEventListener('click', () => show(current + 1));

    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        show(current - 1);
      }
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        show(current + 1);
      }
    });

    /* Clicking the backdrop closes. The dialog element itself fills the
       viewport, so compare against the figure rather than the dialog box. */
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    /* Return focus to the thumbnail that opened it. */
    dialog.addEventListener('close', () => {
      opener?.focus();
      opener = null;
    });
  }

  init();
  document.addEventListener('astro:after-swap', init);
</script>
